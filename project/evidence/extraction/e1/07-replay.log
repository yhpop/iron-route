        '   }}return best;\n' +
        "  },setDestroyed(ids=[]){if(disposed)throw new Error('Ruined depot world is disposed');destroyed=new Set(ids);const ownerSpans=(spec.geometry||[]).filter(c=>destroyed.has(c.ruinInstanceId)).map(c=>c.id);base.setDestroyed([...ids,...ownerSpans]);},\n" +
