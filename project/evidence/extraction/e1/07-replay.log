      'src/battlefront-depot-front.js': "import {createScannedCoverFront} from './scanned-cover-front.js';\n" +
        "import {sampleGroundContact} from './terrain-candidate/heightfield.js';\n" +
        "import {ruinedDepotColliders} from './ruined-depot-layout.js';\n" +
        '/** Independent damaged freight yard. No field edits or hidden intact workshop.\n' +
        ' * The exact instance array is consumed by view, movement proxies and shell rays. */\n' +
        'export function createBattlefrontDepotFront(){\n' +
        ' const {spec,field}=createScannedCoverFront();\n' +
        " spec.id='mission-9080';spec.index=9080;spec.slug='battlefront-depot';spec.optional=true;spec.battlefrontDepot=true;spec.ruinedDepot=true;\n" +
        " spec.title='破损货场 · 双线接应';\n" +
        " spec.briefing='护送补给车穿过破损货场，到达北侧接应区。东侧硬路短，窗墙和装甲巡逻车封锁侧翼；西侧绕行可借中央山脊与装卸区断墙遮挡炮火。南侧支援车会真实交火，南侧支援车在装填间隙转移。按 H 或点车队待命，先侦察再推进。窗口可通炮弹，人行破口不是坦克通道。友军和残骸会挡住炮弹与车辆；不要把敌车残骸留在车队路线上。无需消灭所有敌人。';\n" +
        " spec.ruinedDepotLayout=[{id:'ruin-west-loading',moduleId:'broken-corner',x:-30,y:0,z:18,yaw:Math.PI},{id:'ruin-west-workshop',moduleId:'workshop',x:-32,y:0,z:-5,yaw:Math.PI},{id:'ruin-east-window',moduleId:'window-wall',x:19.5,y:0,z:0,yaw:Math.PI/2}];\n" +
        ' spec.ruinedDepotFoundations=[];\n' +
        " spec.geometry=[...spec.geometry.filter(c=>!['west-workshop','scorched-east-low-wall'].includes(c.id)),...ruinedDepotColliders(spec.ruinedDepotLayout)];\n" +
        " spec.sceneDressing={...spec.sceneDressing,landmarks:spec.sceneDressing.landmarks.filter(l=>l.geometryId!=='west-workshop')};\n" +
        " const placements={'allied-support':{x:-10,z:31,patrol:[{x:-10,z:31},{x:-16,z:31},{x:-16,z:38},{x:-10,z:38}]},'hostile-flanker':{x:2,z:16,patrol:[]},'road-gun':{x:23,z:16,patrol:[{x:23,z:16},{x:23,z:31}]}};\n" +
        ' spec.entities=spec.entities.map(e=>{\n' +
        '  const p=placements[e.id];if(!p)return e;\n' +
        "  const other=placements[e.id==='allied-support'?'hostile-flanker':'allied-support'],yaw=e.id==='road-gun'?0:Math.atan2(-(other.x-p.x),-(other.z-p.z)),g=sampleGroundContact(field,p.x,p.z,yaw);\n" +
        '  return {...e,pose:{x:p.x,z:p.z,y:g.height+.008,yaw},patrol:p.patrol};\n' +
        ' });\n' +
        " spec.design={...spec.design,terrainChange:'none; exact scanned-cover field/roads/spawn/routes retained',ruinComposition:'Damaged west repair workshop replaces matching intact building; loading corner and eastern window-wall retain shared exact transforms',teamEncounter:'Closed southern-apron support patrol, stationary ridge-foot flanker cover, eastern road patrol and northern overwatch; no target or weapon changes',ruinCollision:'757 exported shell triangles; 61 movement spans; three existing modules, no foundations'};\n" +
        ' return {spec,field};\n' +
        '}\n',
      'src/campaign-simulation.js': "import {validateCombatRelations} from './combat-relations.js';\n" +
        "import {playerControllerConfig} from './player-config.js';\n" +
        "import {stepInterceptors} from './interceptor.js';\n" +
        "import {stepCrushing} from './crushing.js';\n" +
        "import { createTank, stepTank } from './tank-controller.js';\n" +
        "import { createCombatState, initializeEntities, stepCombat, destroyedColliderIds, syncWorldEntities } from './combat.js';\n" +
        "import { createObjectiveStates, stepTrucks, stepObjectives } from './mission-runtime.js';\n" +
        '\n' +
        '/** Every retained value is serializable. Mission data is embedded because stepGame needs no registry or globals. */\n' +
        'export function createGame(spec) {\n' +
        "  if (!spec || spec.schema !== 1 || typeof spec.id !== 'string') throw new TypeError('createGame requires a schema:1 MissionSpec with an id');\n" +
        '  validateCombatRelations(spec);\n' +
        '  const mission = JSON.parse(JSON.stringify(spec));\n' +
        '  const tank = createTank(mission.spawn);\n' +
        "  return { schema: 1, missionId: mission.id, mission, tick: 0, elapsed: 0, phase: 'briefing', tank,\n" +
        '    tankFrame: stepTank(tank, { paused: true }, 1 / 60, undefined, playerControllerConfig(mission)).frame,\n' +
        '    tankCombat: createCombatState(mission), entities: initializeEntities(mission), projectiles: [],\n' +
        '    objectiveStates: createObjectiveStates(mission), events: [], result: null, nextEventId: 1, nextProjectileId: 1,\n' +
        "    ...(mission.convoyCommands === true ? { convoyOrder: 'advance' } : {}),\n" +
        "    ...(Object.hasOwn(mission, 'convoyChoice') ? { selectedConvoyChoiceId: null } : {}) };\n" +
        '}\n' +
        '\n' +
        'function nextDraft(previous) {\n' +
        '  return { ...previous, tankCombat: { ...previous.tankCombat },\n' +
        '    entities: Object.fromEntries(Object.entries(previous.entities).map(([id, e]) => [id, { ...e, pose: { ...e.pose }, ...(e.telegraphTarget ? { telegraphTarget: { ...e.telegraphTarget } } : {}) }])),\n' +
        '    projectiles: previous.projectiles.map(p => ({ ...p, position: { ...p.position }, previousPosition: { ...p.previousPosition }, velocity: { ...p.velocity } })),\n' +
        '    objectiveStates: Object.fromEntries(Object.entries(previous.objectiveStates).map(([id, objective]) => [id, { ...objective }])), events: [] };\n' +
        '}\n' +
        '\n' +
        '/** Fixed-step orchestration. Commands change phase only, and never consume a movement/fire tick. */\n' +
        'export function stepGame(previous, input = {}, dt = 1 / 60, world = {}) {\n' +
        "  if (!Number.isFinite(dt) || dt <= 0 || dt > .1) throw new RangeError('Game dt must be finite, positive, and <= 0.1 seconds');\n" +
        '  world.setDestroyed?.(destroyedColliderIds(previous));\n' +
        '  syncWorldEntities(previous, world);\n' +
        "  if (input.pause && previous.phase === 'playing') return { ...previous, phase: 'paused', events: [] };\n" +
        "  if ((input.start && previous.phase === 'briefing') || (input.resume && previous.phase === 'paused')) return { ...previous, phase: 'playing', events: [] };\n" +
        "  if (previous.phase !== 'playing' || input.paused) return previous.events.length ? { ...previous, events: [] } : previous;\n" +
        '  const next = nextDraft(previous);\n' +
        '  next.tick++; next.elapsed += dt;\n' +
        '  if (next.mission.convoyCommands === true &&\n' +
        '      (!next.mission.convoyChoice || next.selectedConvoyChoiceId) &&\n' +
        "      ['hold', 'advance'].includes(input.convoyOrder)) next.convoyOrder = input.convoyOrder;\n" +
        '  const ready = next.tankCombat.hp > 0 && next.tankCombat.reload - dt <= 1e-8;\n' +
        '  const driven = stepTank(previous.tank, { ...input, firePressed: Boolean(input.firePressed && ready) }, dt, world, playerControllerConfig(next.mission));\n' +
        '  next.tank = driven.state; next.tankFrame = driven.frame;\n' +
        '  stepCrushing(next,dt,world);\n' +
        '  syncWorldEntities(next, world);\n' +
        '  stepInterceptors(next, dt, world);\n' +
        '  syncWorldEntities(next, world);\n' +
        '  stepCombat(next, dt, world, driven.events);\n' +
        '  // Apply losses/objective releases before moving vehicles, then verify physical terminal states.\n' +
        '  stepObjectives(next, 0);\n' +
        "  if (next.phase === 'playing') {\n" +
        '    syncWorldEntities(next, world);\n' +
        '    stepTrucks(next, dt, world);\n' +
        '    syncWorldEntities(next, world);\n' +
        '    stepObjectives(next, dt);\n' +
        '  }\n' +
        '  return next;\n' +
        '}\n' +
        '\n' +
        'export function retry(spec) { return createGame(spec); }\n',
      'src/campaign-world-accelerated.js': '/** Height-aware deterministic collision queries. No renderer, wall clock, mutable GameState or physics worker. */\n' +
        "import {conservativeShapeBounds,boundsMayContact} from './collision-broadphase.js';\n" +
        "import { DEFAULT_CONFIG, getTankTransform, integrateArc, rotateYaw, hullVector, wrapAngle } from './tank-controller.js';\n" +
        'const SKIN=.015, SAMPLE_MARGIN=SKIN*2, EPS=1e-9, MAX_ANGLE=Math.PI/90;\n' +
        'const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\n' +
        'const lerp=(a,b,t)=>a+(b-a)*t;\n' +
        'const point=(p={})=>({x:p.x??0,y:p.y??0,z:p.z??0});\n' +
        'const plus=(a,b)=>({x:a.x+b.x,y:a.y+b.y,z:a.z+b.z});\n' +
        'const distance=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y,a.z-b.z);\n' +
        'const norm=v=>{const n=Math.hypot(v.x,v.y,v.z)||1;return {x:v.x/n,y:v.y/n,z:v.z/n};};\n' +
        'const local=(p,b)=>rotateYaw({x:p.x-b.x,y:p.y-b.y,z:p.z-b.z},-b.yaw);\n' +
        'const sizeRadius=box=>Math.hypot(box.width/2,box.height/2,box.depth/2);\n' +
        "function makeBox(origin,yaw,proxy) {return {kind:'box',...plus(origin,rotateYaw(point(proxy.offset),yaw)),yaw,width:proxy.width,depth:proxy.depth,height:proxy.height};}\n" +
        'function tiltedBox(pose,proxy,origin,yawRel=0){\n' +
        ' const corners=[];for(const x of [-.5,.5])for(const y of [-.5,.5])for(const z of [-.5,.5]){const p={x:proxy.offset.x+x*proxy.width,y:proxy.offset.y+y*proxy.height,z:proxy.offset.z+z*proxy.depth};corners.push(plus(pose,hullVector(plus(origin,rotateYaw(p,yawRel)),pose)));}\n' +
        " const range=k=>[Math.min(...corners.map(p=>p[k])),Math.max(...corners.map(p=>p[k]))];const [x,X]=range('x'),[y,Y]=range('y'),[z,Z]=range('z');\n" +
        " return {kind:'box',x:(x+X)/2,y:(y+Y)/2,z:(z+Z)/2,yaw:0,width:X-x,height:Y-y,depth:Z-z};\n" +
        '}\n' +
        'function partsAt(transform,rig) {\n' +
        '  const t=getTankTransform(transform,rig),yaw=transform.pose.yaw+transform.turret.yawRel;\n' +
        '  return [\n' +
        "    {...(transform.pose.basis?tiltedBox(transform.pose,rig.hullProxy,{x:0,y:0,z:0}):makeBox(transform.pose,transform.pose.yaw,rig.hullProxy)),part:'body'},\n" +
        "    {...(transform.pose.basis?tiltedBox(transform.pose,rig.turretProxy,rig.turretPivot,transform.turret.yawRel):makeBox(t.turretOrigin,yaw,rig.turretProxy)),part:'turret'},\n" +
        "    {kind:'capsule',a:t.barrelStart,b:t.barrelEnd,radius:rig.barrelCapsule.radius,part:'barrel'},\n" +
        '  ];\n' +
        '}\n' +
        'function boxBoxGap(a,b) {\n' +
        '  const dx=b.x-a.x,dz=b.z-a.z;\n' +
        '  let gap=Math.abs(b.y-a.y)-(a.height+b.height)/2;\n' +
        '  for(const yaw of [a.yaw,b.yaw]) for(const offset of [0,Math.PI/2]) {\n' +
        '    const x=Math.cos(yaw+offset),z=-Math.sin(yaw+offset);\n' +
        '    const radius=q=>Math.abs(x*Math.cos(q.yaw)-z*Math.sin(q.yaw))*q.width/2+Math.abs(x*Math.sin(q.yaw)+z*Math.cos(q.yaw))*q.depth/2;\n' +
        '    gap=Math.max(gap,Math.abs(dx*x+dz*z)-radius(a)-radius(b));\n' +
