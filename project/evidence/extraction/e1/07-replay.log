      'src/combat-relations.js': '/** Explicit, serialized opt-in combat ownership. Absence preserves legacy rules. */\n' +
        'export const factionCombat=state=>state?.mission?.combatRelations?.version===1;\n' +
        "function known(state,team){return typeof team==='string'&&state.mission.combatRelations.teams?.includes(team)?team:null;}\n" +
