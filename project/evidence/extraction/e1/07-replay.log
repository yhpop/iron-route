      'src/terrain-candidate/combat-world-accelerated.js': "import {playerRig} from '../player-config.js';\n" +
        "import {createWorld} from '../campaign-world-accelerated.js';\n" +
        "import {sampleGroundContact,terrainSurfaceAt} from './heightfield.js';\n" +
        "import {attachTerrainQueries} from './combat-surface.js';\n" +
