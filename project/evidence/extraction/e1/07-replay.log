      'src/interceptor.js': "import {playerCollider} from './player-config.js';\n" +
        '/** Game-scale adapter of konserwa CC0 Panzer III; values are not historical statistics. */\n' +
        'export const INTERCEPTOR_RIG=Object.freeze({yawHeight:1.044,pitchHeight:.182,pitchForward:.56,barrelLength:1.52,minElevation:-.12,maxElevation:.3,maxRecoil:.07});\n' +
