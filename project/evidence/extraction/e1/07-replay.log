        " const patrols={'allied-support':[{x:-4,z:18},{x:-5,z:16}],'hostile-flanker':[{x:1.2,z:16},{x:0,z:16}]};\n" +
        ' // V4-only relocation avoids the inherited steep ridge: the authored PzIII\n' +
        ' // view is upright, so terrain fit was checked against its real mesh + treads.\n' +
        " const support=spec.entities.find(e=>e.id==='allied-support').pose,p={x:1.2,z:16},yaw=Math.atan2(-(support.x-p.x),-(support.z-p.z)),ground=sampleGroundContact(field,p.x,p.z,yaw);\n" +
        " spec.entities=spec.entities.map(e=>patrols[e.id]?{...e,...(e.id==='hostile-flanker'?{pose:{...p,y:ground.height+.008,yaw}}:{}),patrol:patrols[e.id]}:e);\n" +
        " spec.design={...spec.design,teamEncounter:'visible opening exchange between two real moving off-lane combat vehicles',supportRole:'temporary distraction; collision-swept reload patrols, parked during charge; not an escort objective',newVehiclePositions:'short swept patrols off both convoy corridors; persistent wrecks remain solid',openingEvidence:'offline production simulation, compound sweeps and exact main-camera projections; not a GPU/CSS/device pass'};\n" +
        ' return {spec,field};\n' +
        '}\n',
      'src/crushing.js': "import {playerRig} from './player-config.js';\n" +
