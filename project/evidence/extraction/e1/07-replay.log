        '   for(const instance of instances){if(ignored.has(instance.id)||destroyed.has(instance.id)||!intersectsBounds(from,d,instance.bounds))continue;for(let triangleIndex=0;triangleIndex<instance.triangles.length;triangleIndex++){\n' +
        '    const hit=triangleHit(from,d,instance.triangles[triangleIndex]);if(!hit||best&&hit.fraction>=best.fraction-1e-12)continue;\n' +
