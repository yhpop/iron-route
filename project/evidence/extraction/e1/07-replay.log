      'src/battlefront-depot-front.js': "import {createScannedCoverFront} from './scanned-cover-front.js';\n" +
        "import {sampleGroundContact} from './terrain-candidate/heightfield.js';\n" +
        "import {ruinedDepotColliders} from './ruined-depot-layout.js';\n" +
        '/** Independent damaged freight yard. No field edits or hidden intact workshop.\n' +
        ' * The exact instance array is consumed by view, movement proxies and shell rays. */\n' +
        'export function createBattlefrontDepotFront(){\n' +
        ' const {spec,field}=createScannedCoverFront();\n' +
        " spec.id='mission-9080';spec.index=9080;spec.slug='battlefront-depot';spec.optional=true;spec.battlefrontDepot=true;spec.ruinedDepot=true;\n" +
        " spec.title='破损货场 · 双线接应';\n" +
        " spec.briefing='护送补给车穿过破损货场，到达北侧接应区。东侧硬路短，窗墙和装甲巡逻车封锁侧翼；西侧绕行可借中央山脊与装卸区断墙遮挡炮火。南侧支援车会真实交火，南侧支援车在装填间隙转移。按 H 或点车队待命，先侦察再推进。窗口可通炮弹，人行破口不是坦克通道。友军和残骸会挡住炮弹与车辆；不要把敌车残骸留在车队路线上。无需消灭所有敌人。';\n" +
        " spec.ruinedDepotLayout=[{id:'ruin-west-loading',moduleId:'broken-corner',x:-30,y:0,z:18,yaw:Math.PI},{id:'ruin-west-workshop',moduleId:'workshop',x:-32,y:0,z:-5,yaw:Math.PI},{id:'ruin-east-window',moduleId:'window-wall',x:19.5,y:0,z:0,yaw:Math.PI/2}];\n" +
        ' spec.ruinedDepotFoundations=[];\n' +
        " spec.geometry=[...spec.geometry.filter(c=>!['west-workshop','scorched-east-low-wall'].includes(c.id)),...ruinedDepotColliders(spec.ruinedDepotLayout)];\n" +
        " spec.sceneDressing={...spec.sceneDressing,landmarks:spec.sceneDressing.landmarks.filter(l=>l.geometryId!=='west-workshop')};\n" +
        " const placements={'allied-support':{x:-10,z:31,patrol:[{x:-10,z:31},{x:-16,z:31},{x:-16,z:38},{x:-10,z:38}]},'hostile-flanker':{x:2,z:16,patrol:[]},'road-gun':{x:23,z:16,patrol:[{x:23,z:16},{x:23,z:31}]}};\n" +
        ' spec.entities=spec.entities.map(e=>{\n' +
        '  const p=placements[e.id];if(!p)return e;\n' +
        "  const other=placements[e.id==='allied-support'?'hostile-flanker':'allied-support'],yaw=e.id==='road-gun'?0:Math.atan2(-(other.x-p.x),-(other.z-p.z)),g=sampleGroundContact(field,p.x,p.z,yaw);\n" +
        '  return {...e,pose:{x:p.x,z:p.z,y:g.height+.008,yaw},patrol:p.patrol};\n' +
        ' });\n' +
        " spec.design={...spec.design,terrainChange:'none; exact scanned-cover field/roads/spawn/routes retained',ruinComposition:'Damaged west repair workshop replaces matching intact building; loading corner and eastern window-wall retain shared exact transforms',teamEncounter:'Closed southern-apron support patrol, stationary ridge-foot flanker cover, eastern road patrol and northern overwatch; no target or weapon changes',ruinCollision:'757 exported shell triangles; 61 movement spans; three existing modules, no foundations'};\n" +
        ' return {spec,field};\n' +
        '}\n',
      'src/campaign-simulation.js': "import {validateCombatRelations} from './combat-relations.js';\n" +
        "import {playerControllerConfig} from './player-config.js';\n" +
        "import {stepInterceptors} from './interceptor.js';\n" +
        "import {stepCrushing} from './crushing.js';\n" +
        "import { createTank, stepTank } from './tank-controller.js';\n" +
        "import { createCombatState, initializeEntities, stepCombat, destroyedColliderIds, syncWorldEntities } from './combat.js';\n" +
        "import { createObjectiveStates, stepTrucks, stepObjectives } from './mission-runtime.js';\n" +
        '\n' +
        '/** Every retained value is serializable. Mission data is embedded because stepGame needs no registry or globals. */\n' +
        'export function createGame(spec) {\n' +
        "  if (!spec || spec.schema !== 1 || typeof spec.id !== 'string') throw new TypeError('createGame requires a schema:1 MissionSpec with an id');\n" +
        '  validateCombatRelations(spec);\n' +
        '  const mission = JSON.parse(JSON.stringify(spec));\n' +
        '  const tank = createTank(mission.spawn);\n' +
        "  return { schema: 1, missionId: mission.id, mission, tick: 0, elapsed: 0, phase: 'briefing', tank,\n" +
