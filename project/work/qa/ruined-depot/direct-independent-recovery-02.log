        " spec.geometry=[...spec.geometry,...[[19.5,16],[19.5,-12],[-26.2,8]].map(([x,z],i)=>({id:SCANNED_COVER_IDS[i],kind:'box',x,z,y:sampleHeightfield(field,x,z).height,yaw:Math.PI/2,width:1.56540936,depth:.44214198,height:1.11195294}))];\n" +
