        '}\n' +
        '\n' +
        '/** Fixed-step orchestration. Commands change phase only, and never consume a movement/fire tick. */\n' +
        'export function stepGame(previous, input = {}, dt = 1 / 60, world = {}) {\n' +
        "  if (!Number.isFinite(dt) || dt <= 0 || dt > .1) throw new RangeError('Game dt must be finite, positive, and <= 0.1 seconds');\n" +
        '  world.setDestroyed?.(destroyedColliderIds(previous));\n' +
