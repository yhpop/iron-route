        " const cuts=[lo,hi];for(const [axis,min,step,n] of [['x',b.minX,f.dx,f.columns],['z',b.minZ,f.dz,f.rows]])if(Math.abs(d[axis])>1e-12){const a=from[axis]+d[axis]*lo,c=from[axis]+d[axis]*hi;for(let k=Math.max(1,Math.ceil((Math.min(a,c)-min)/step));k<=Math.min(n-1,Math.floor((Math.max(a,c)-min)/step));k++){const t=(min+k*step-from[axis])/d[axis];if(t>lo&&t<hi)cuts.push(t);}}\n" +
        ' cuts.sort((a,b)=>a-b);const cells=new Set();for(let n=0;n<cuts.length-1;n++){const p=at(from,d,(cuts[n]+cuts[n+1])/2),i=Math.min(f.columns-1,Math.max(0,Math.floor((p.x-b.minX)/f.dx))),j=Math.min(f.rows-1,Math.max(0,Math.floor((p.z-b.minZ)/f.dz)));cells.add(`${i},${j}`);}\n' +
        ' let best=null;const vertex=(i,j)=>({x:b.minX+i*f.dx,y:f.heights[j*(f.columns+1)+i],z:b.minZ+j*f.dz});\n' +
        " for(const cell of cells){const [i,j]=cell.split(',').map(Number),a=vertex(i,j),c=vertex(i+1,j),e=vertex(i,j+1),g=vertex(i+1,j+1);for(const tri of [[a,c,e],[g,e,c]]){const t=triangle(from,d,...tri);if(t!==null&&t>=lo-1e-9&&t<=hi+1e-9&&(best===null||t<best))best=t;}}\n" +
        ' return best===null?null:result(best);\n' +
        '}\n' +
        'export function attachTerrainQueries(base,field){return {...base,terrain:field,\n' +
        ' raycast(from,to,ignore){const a=base.raycast?.(from,to,ignore),b=raycastTerrain(field,from,to);return a&&(!b||a.fraction<=b.fraction)?a:b;},\n' +
        ' projectileInBounds:p=>inside(field,p)&&p.y>=sampleHeightfield(field,p.x,p.z).height-.02,\n' +
        ' muzzleContacts(t,rig,ignoreIds){\n' +
        '  const baseResult=base.muzzleContacts?.(t,rig,ignoreIds);if(baseResult?.contacts.length)return baseResult;\n' +
        "  if(!baseResult&&base.muzzleClear&&!base.muzzleClear(t,rig))return {contacts:['obstacle'],blockedPart:'barrel'};\n" +
        '  const radius=rig?.barrelCapsule?.radius??.151;\n' +
        "  for(const [a,b,r,part] of [[t.barrelStart,t.barrelEnd,radius,'barrel'],[t.position,at(t.position,t.direction,.22),.045,'muzzle']]){\n" +
        "   if(!inside(field,a)||!inside(field,b))return {contacts:['terrain-boundary'],blockedPart:part};\n" +
        '   const n=Math.max(1,Math.ceil(Math.hypot(b.x-a.x,b.z-a.z)/Math.min(field.dx,field.dz)*4));\n' +
        "   for(let i=0;i<=n;i++){const p=at(a,sub(b,a),i/n);if(p.y-r<=sampleHeightfield(field,p.x,p.z).height+.015)return {contacts:['terrain'],blockedPart:part};}\n" +
        '  }\n' +
        '  return {contacts:[],blockedPart:null};\n' +
        ' },\n' +
        ' muzzleClear(t,rig){return this.muzzleContacts(t,rig).contacts.length===0;}\n' +
        '};}\n',
      'src/terrain-candidate/combat-world.js': "import {playerRig} from '../player-config.js';\n" +
        "import {createWorld} from '../campaign-world.js';\n" +
        "import {sampleGroundContact,terrainSurfaceAt} from './heightfield.js';\n" +
        "import {attachTerrainQueries} from './combat-surface.js';\n" +
        "import {getTankTransform,hullVector} from '../tank-controller.js';\n" +
        '/** Isolated authored gentle-terrain adapter. Tilted body collision uses conservative AABBs,\n' +
        ' * not exact 6DOF rigid-body physics; unsupported map edge remains blocked. */\n' +
        'export function createTerrainCombatWorld(spec,field){\n' +
        ' const groundPose=p=>{const hull=playerRig(spec).hullProxy,c=spec.playerVehicle?sampleGroundContact(field,p.x,p.z,p.yaw,{halfWidth:hull.width/2,halfLength:hull.depth/2}):sampleGroundContact(field,p.x,p.z,p.yaw);return {...p,y:c.height+.008,basis:c.basis};};\n' +
        ' let destroyed=new Set();\n' +
        ' const base=createWorld(spec,{groundPose}),world=attachTerrainQueries(base,field);\n' +
        ' return {...world,groundPose,\n' +
        '  setDestroyed(ids=[]){destroyed=new Set(ids);base.setDestroyed(ids);},\n' +
        '  // Travel-only convenience: lift the real barrel before a low crushable enters\n' +
        '  // its reach. Does not remove colliders, deal damage, rotate yaw or bypass sweeps.\n' +
        '  travelElevationFloor(pose,speed){\n' +
        '   if(Math.abs(speed)<.1)return null;\n' +
        '   for(const c of spec.geometry||[]){\n' +
        '    if(destroyed.has(c.id)||!c.destructible||!c.crush||!(c.height<=.8)||!(c.crush.seconds>0))continue;\n' +
        '    const local=hullVector({x:c.x-pose.x,y:(c.y||0)-pose.y,z:c.z-pose.z},pose,true),ahead=-local.z*Math.sign(speed),radius=Math.hypot(c.width||0,c.depth||0)/2;\n' +
        '    if(ahead>=-1.5&&ahead<=5+radius&&Math.abs(local.x)<=1.3+radius)return .18;\n' +
        '   }\n' +
        '   return null;\n' +
        '  },surfaceAt:p=>terrainSurfaceAt(field,p.x,p.z),\n' +
        '  sweepHullAndAttachedGun(from,to,rig,ignoreIds){\n' +
        '   const b=field.bounds,p=to.pose;\n' +
        "   if(p.x<b.minX+3||p.x>b.maxX-3||p.z<b.minZ+3||p.z>b.maxZ-3)return {accepted:from,forwardDistance:0,blocked:true,contacts:['terrain-boundary']};\n" +
        '   const result=base.sweepHullAndAttachedGun(from,{...to,pose:groundPose(to.pose)},rig,ignoreIds);\n' +
        '   const clearance=world.muzzleContacts(getTankTransform(result.accepted,rig),rig,ignoreIds);if(clearance.contacts.length)return {accepted:from,forwardDistance:0,blocked:true,blockedPart:clearance.blockedPart,contacts:clearance.contacts};\n' +
        '   return result;\n' +
        '  },\n' +
        '  sweepTurretAtHull(pose,from,to,rig){const result=base.sweepTurretAtHull(pose,from,to,rig);const clearance=world.muzzleContacts(getTankTransform({pose,turret:result.accepted},rig),rig);if(clearance.contacts.length)return {accepted:from,blocked:true,contacts:clearance.contacts,blockedPart:clearance.blockedPart};return result;}\n' +
        ' };\n' +
        '}\n',
      'src/terrain-candidate/heightfield.js': "import {noise} from './vendor/three-terrain/noise.js';\n" +
        '\n' +
        'noise.seed(5271);\n' +
        '\n' +
        '/** Original deterministic terrain model. Geometry and support use the SAME grid triangles. */\n' +
        'const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\n' +
        '\n' +
        'const smooth=t=>{t=clamp(t,0,1);\n' +
        'return t*t*(3-2*t);\n' +
        '};\n' +
        '\n' +
        "export const HEIGHTFIELD_PRESET=Object.freeze({bounds:{minX:-60,maxX:60,minZ:-60,maxZ:60},cellSize:.75,roads:[{width:7,material:'asphalt',points:[[-60,0],[-15,0],[16,0],[60,8]]},{width:5,material:'earth',points:[[-15,0],[0,12],[18,20],[38,15],[60,8]]}]});\n" +
        '\n' +
        'export function roadSample(roads,x,z){let best=null;\n' +
        'for(const r of roads||[])for(let i=1;\n' +
        'i<r.points.length;\n' +
        'i++){const a=r.points[i-1],b=r.points[i],dx=b[0]-a[0],dz=b[1]-a[1],length2=dx*dx+dz*dz;\n' +
        'if(!length2)continue;\n' +
        'const t=clamp(((x-a[0])*dx+(z-a[1])*dz)/length2,0,1),px=a[0]+t*dx,pz=a[1]+t*dz,d=Math.hypot(x-px,z-pz),edge=d-r.width/2;\n' +
        'if(!best||edge<best.edge)best={distance:d,edge,x:px,z:pz,width:r.width,material:r.material};\n' +
        '}return best;\n' +
        '}\n' +
        'const naturalHeight=(x,z)=>3.8*Math.exp(-((x-10)**2/520+(z-23)**2/240))+2.2*Math.exp(-((x+26)**2/600+(z+22)**2/300))-.7*Math.exp(-((x-30)**2/650+(z+26)**2/190))+.12*noise.simplex(x*.055,z*.055)+.025*noise.perlin(x*.3,z*.3);\n' +
        '\n' +
        'function authoredHeight(x,z,roads){const h=naturalHeight(x,z),r=roadSample(roads,x,z);\n' +
        'if(!r)return h;\n' +
        "const blend=1-smooth((r.distance-r.width/2)/4.5),crown=.055*(1-clamp(r.distance/(r.width/2),0,1)**2),rut=r.material==='earth'?-.035*Math.exp(-(((r.distance-r.width*.27)/.22)**2)):0;\n" +
        'return h+(crown+rut)*blend;\n' +
        '}\n' +
        'export function createHeightfield(spec){const b=spec?.bounds,cell=spec?.cellSize;\n' +
        "if(!b||![b.minX,b.maxX,b.minZ,b.maxZ,cell].every(Number.isFinite)||b.maxX<=b.minX||b.maxZ<=b.minZ||cell<=0)throw new RangeError('Invalid heightfield dimensions');\n" +
        'const columns=Math.ceil((b.maxX-b.minX)/cell),rows=Math.ceil((b.maxZ-b.minZ)/cell);\n' +
        "if(columns*rows>250000)throw new RangeError('Heightfield exceeds candidate budget');\n" +
        'const dx=(b.maxX-b.minX)/columns,dz=(b.maxZ-b.minZ)/rows,heights=new Float64Array((columns+1)*(rows+1)),roads=JSON.parse(JSON.stringify(spec.roads||[]));\n' +
        'for(let j=0;\n' +
        'j<=rows;\n' +
        'j++)for(let i=0;\n' +
        'i<=columns;\n' +
        'i++){const x=b.minX+i*dx,z=b.minZ+j*dz,h=spec.heightAt?spec.heightAt(x,z):authoredHeight(x,z,roads);\n' +
        "if(!Number.isFinite(h))throw new RangeError('Non-finite terrain height');\n" +
        'heights[j*(columns+1)+i]=h;\n' +
        '}return {bounds:{...b},columns,rows,dx,dz,heights,roads};\n' +
        '}\n' +
        'export function sampleHeightfield(f,x,z){const b=f.bounds;\n' +
        "if(!Number.isFinite(x)||!Number.isFinite(z)||x<b.minX||x>b.maxX||z<b.minZ||z>b.maxZ)throw new RangeError('Terrain sample outside bounds');\n" +
        'const gx=(x-b.minX)/f.dx,gz=(z-b.minZ)/f.dz,i=Math.min(Math.floor(gx),f.columns-1),j=Math.min(Math.floor(gz),f.rows-1),u=gx-i,v=gz-j,k=j*(f.columns+1)+i,a=f.heights[k],bb=f.heights[k+1],c=f.heights[k+f.columns+1],d=f.heights[k+f.columns+2];\n' +
        'let height,sx,sz;\n' +
        'if(u+v<=1){height=a+(bb-a)*u+(c-a)*v;\n' +
        'sx=(bb-a)/f.dx;\n' +
        'sz=(c-a)/f.dz;\n' +
        '}else{height=d+(c-d)*(1-u)+(bb-d)*(1-v);\n' +
        'sx=(d-c)/f.dx;\n' +
        'sz=(d-bb)/f.dz;\n' +
        '}const length=Math.hypot(sx,1,sz);\n' +
        'return {height,normal:{x:-sx/length,y:1/length,z:-sz/length},cell:[i,j],triangle:u+v<=1?0:1};\n' +
        '}\n' +
        "export function terrainSurfaceAt(f,x,z){const hard=roadSample(f.roads.filter(r=>r.material==='asphalt'),x,z),r=hard&&hard.edge<0?hard:roadSample(f.roads,x,z),road=r&&r.edge<0;\n" +
        "return {class:road&&r.material==='asphalt'?'road':'earth',traction:road&&r.material==='asphalt'?1:.76,drag:road&&r.material==='asphalt'?1:1.35,roadBlend:r?1-smooth((r.edge+.35)/1.8):0,roadMaterial:r?.material||null};\n" +
        '}\n' +
        '/** Four support points define a conservative rigid support plane. Suspension is not simulated. */\n' +
        'export function sampleGroundContact(f,x,z,yaw,{halfWidth=.95,halfLength=1.41}={}){\n' +
        ' const co=Math.cos(yaw),si=Math.sin(yaw),at=(lx,lz)=>sampleHeightfield(f,x+co*lx+si*lz,z-si*lx+co*lz).height;\n' +
        '\n' +
        ' const sx=(at(halfWidth,0)-at(-halfWidth,0))/(2*halfWidth),sz=(at(0,halfLength)-at(0,-halfLength))/(2*halfLength);\n' +
        '\n' +
        ' const normalize=v=>{const l=Math.hypot(...v);\n' +
        'return v.map(n=>n/l);\n' +
        '},cross=(a,b)=>[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]];\n' +
        '\n' +
        ' const up=normalize([-sx,1,-sz]),right0=normalize([1,sx,0]),forward=normalize(cross(right0,up)),right=normalize(cross(up,forward)),samples=[];\n' +
        '\n' +
        ' for(const lx of [-halfWidth,0,halfWidth])for(let i=0;\n' +
        'i<=8;\n' +
        'i++){const lz=-halfLength+i*halfLength/4,rx=right[0]*lx+forward[0]*lz,ry=right[1]*lx+forward[1]*lz,rz=right[2]*lx+forward[2]*lz,wx=x+co*rx+si*rz,wz=z-si*rx+co*rz;\n' +
        'samples.push({lx,lz,x:wx,z:wz,offsetY:ry,groundY:sampleHeightfield(f,wx,wz).height});\n' +
        '}\n' +
        ' const height=Math.max(...samples.map(s=>s.groundY-s.offsetY));\n' +
        'for(const s of samples)s.supportY=height+s.offsetY;\n' +
        '\n' +
        ' return {height,pitch:Math.atan(sz),roll:-Math.atan(sx),slopeX:sx,slopeZ:sz,basis:{right,up,forward},maxGap:Math.max(...samples.map(s=>s.supportY-s.groundY)),samples};\n' +
        '\n' +
        '}\n',
      'src/terrain-candidate/interceptor-mission.js': "import {createRidgeConvoyMission} from './ridge-convoy.js';\n" +
        '/** Separate experiment; no default campaign or player asset is replaced. */\n' +
        'export function createInterceptorMission(){\n' +
        " const {spec,field}=createRidgeConvoyMission();spec.id='mission-9006';spec.index=9006;spec.title='堤路护送 · 装甲巡逻队';\n" +
        " spec.briefing='东路出现装甲巡逻车：它在装填时转移阵地，发现目标后停车瞄准，炮口预警锁定后可以闪避。不要正面对射；利用山脊断开视线，或趁它装填绕到侧后。车队可以待命，先侦察再决定走东侧硬路还是西侧低地。玩家仍驾驶原有坦克。';\n" +
        " const e=spec.entities.find(e=>e.id==='road-gun');Object.assign(e,{vehicle:'pz3',radius:2.2,width:1.921792,depth:3.532506,height:1.7,hp:90,shieldArc:1.7,range:19,chargeTime:1.9,reload:4.5,damage:14,patrol:[{x:23,z:3},{x:23,z:-12}],patrolIndex:1,speed:0,travel:0});e.pose.yaw=0;\n" +
        ' return {spec,field};\n' +
        '}\n',
      'src/terrain-candidate/ridge-convoy.js': "import {createHeightfield,roadSample,sampleHeightfield} from './heightfield.js';\n" +
        'const rect=(id,x,z,w,d)=>({id,polygon:[{x:x-w/2,z:z-d/2},{x:x+w/2,z:z-d/2},{x:x+w/2,z:z+d/2},{x:x-w/2,z:z+d/2}]});\n' +
        'const smooth=t=>{t=Math.max(0,Math.min(1,t));return t*t*(3-2*t);};\n' +
        '/** Original authored sortie. Existing convoy choice, combat, crushing and art remain authoritative. */\n' +
        'export function createRidgeConvoyMission(){\n' +
        ' const direct=[[0,28],[14,18],[14,-24],[0,-32]],covered=[[0,28],[-18,18],[-22,4],[-22,-20],[0,-32]];\n' +
        " const roads=[{id:'ridge-east',material:'asphalt',width:7,points:direct},{id:'ridge-west',material:'earth',width:6,points:covered}];\n" +
        ' const geometry=[\n' +
        "  {id:'south-depot',kind:'box',x:-25,z:28,width:8,depth:9,height:4},\n" +
        "  {id:'west-workshop',kind:'box',x:-32,z:-5,width:6,depth:10,height:3.5},\n" +
        "  {id:'north-garage',kind:'box',x:25,z:-30,width:8,depth:7,height:3.2},\n" +
        "  ...Array.from({length:5},(_,i)=>({id:`ridge-fence-${i}`,kind:'box',x:-22.6+i*1.8,z:14,width:1.8,depth:.25,height:.65,destructible:true,hp:90,crush:{seconds:.25,mode:'fence'}}))\n" +
        ' ];\n' +
        ' const bounds={minX:-40,maxX:40,minZ:-42,maxZ:42};\n' +
        " const entities=[{id:'supply',kind:'truck',yieldForTankTurn:true,pose:{x:0,y:0,z:28,yaw:0},hp:100,protected:true,routeId:'ridge-east',speed:1.15,escortRange:19},\n" +
        "  {id:'road-gun',kind:'turret',pose:{x:23,y:0,z:3,yaw:Math.PI},hp:90,range:23,chargeTime:2.1,reload:3.6,damage:8,shieldArc:2.5},\n" +
        "  {id:'ridge-gun',kind:'turret',pose:{x:0,y:0,z:-18,yaw:Math.PI},hp:90,range:28,chargeTime:2.2,reload:3.8,damage:8,shieldArc:2.5}];\n" +
        " const pads=[...geometry.map(c=>({x:c.x,z:c.z,w:c.width,d:c.depth})),...entities.filter(e=>e.kind!=='truck').map(e=>({x:e.pose.x,z:e.pose.z,w:4,d:4}))];\n" +
        ' const field=createHeightfield({bounds,cellSize:.5,roads,heightAt(x,z){let h=4.2*Math.exp(-((x/11)**4)-(((z-1)/10)**4));const r=roadSample(roads,x,z);if(r)h*=smooth((r.distance-6)/4);for(const p of pads){const d=Math.hypot(Math.max(0,Math.abs(x-p.x)-p.w/2),Math.max(0,Math.abs(z-p.z)-p.d/2));h*=smooth((d-1)/3);}return h;}});\n' +
        ' for(const c of geometry)c.y=sampleHeightfield(field,c.x,c.z).height;\n' +
        ' for(const e of entities)e.pose.y=sampleHeightfield(field,e.pose.x,e.pose.z).height;\n' +
        " const spec={schema:1,id:'mission-9005',index:9005,optional:true,terrainCombat:true,districtId:'south-wharf',title:'堤路护送 · 山脊与双线',\n" +
        " briefing:'把补给车带到北部接应区，而不是清空所有炮位。驶入东侧金圈选硬路：路短，但会暴露在炮位前；驶入西侧金圈选低地土路：路长，中央山脊能挡弹，入口木栅须用履带压开。选路后锁定。可点“车队待命”或按 H 把车留在掩体后，绕侧清炮后再按“继续护送”；待命时敌火不会暂停。补给车会等待你靠近，也会停在未清障碍或你的车身后。可先清炮位，再回车队，也可边走边护送。山脊后的北炮位需绕侧才能击中，正面装甲会挡弹。',\n" +
        ' bounds,spawn:{x:0,y:0,z:23,yaw:0},geometry,entities,\n' +
        ' routes:roads.map(r=>({id:r.id,width:r.width,points:r.points.map(([x,z])=>({x,z}))})),\n' +
        " zones:[rect('orders',0,23,8,6),rect('choose-east',8,19,5,6),rect('choose-west',-8,19,5,6),rect('rendezvous',0,-32,10,8)],\n" +
        " objectives:[{id:'receive-orders',type:'reach',requires:[],nextIds:['escort-supply'],targetIds:[],zoneId:'orders',title:'接应补给车，驶入东西集结圈选路'},\n" +
        " {id:'escort-supply',type:'escort',requires:['receive-orders'],nextIds:[],targetIds:['supply'],zoneId:'rendezvous',title:'护送补给车进入北部接应区'}],\n" +
        ' convoyCommands:true,\n' +
        " convoyChoice:{requiresObjectiveId:'receive-orders',prompt:'右侧硬路：短但暴露；左侧低地：长但有山脊掩护。驶入金圈锁定路线',options:[{id:'direct',title:'东侧硬路',zoneId:'choose-east',routeByTruck:{supply:'ridge-east'}},{id:'covered',title:'西侧低地土路',zoneId:'choose-west',routeByTruck:{supply:'ridge-west'}}]},\n" +
        " sceneDressing:{schema:1,districtId:'south-wharf',ground:{material:'concrete'},roads,landmarks:[{geometryId:'south-depot',assetKey:'warehouse-sawtooth',role:'Departure depot'},{geometryId:'west-workshop',assetKey:'service-workshop',role:'Low road marker'},{geometryId:'north-garage',assetKey:'service-workshop',role:'Rendezvous landmark'}],props:[],water:[],drains:[]},\n" +
        " design:{targetSeconds:[150,300],evidence:{humanPlaythrough:'unverified',combatBalance:'unverified'},terrainProof:{blockedPose:{x:8,z:-2,yaw:0},exposedPose:{x:14,z:-18,yaw:0},targetId:'ridge-gun'}}};\n" +
        ' return {spec,field};\n' +
        '}\n',
      'src/terrain-candidate/vendor/three-terrain/noise.js': '/**\n' +
        '* Simplex and Perlin noise.\n' +
        '*\n' +
        '* Copied with small edits from https://github.com/josephg/noisejs which is\n' +
        '* public domain. Originally by Stefan Gustavson (stegu@itn.liu.se) with\n' +
        '* optimizations by Peter Eastman (peastman@drizzle.stanford.edu) and converted\n' +
        '* to JavaScript by Joseph Gentle.\n' +
        '*/\n' +
        '\n' +
        "// Create noise module object that we'll export\n" +
        'const noise = {};\n' +
        '\n' +
        'function Grad(x, y, z) {\n' +
        '    this.x = x;\n' +
        '    this.y = y;\n' +
        '    this.z = z;\n' +
        '}\n' +
        '\n' +
        'Grad.prototype.dot2 = function(x, y) {\n' +
        '    return this.x*x + this.y*y;\n' +
        '};\n' +
        '\n' +
