        '   return {position:barrelPoint(rig.muzzleLocal),direction:hullVector(rotateYaw(rotateElevation({x:0,y:0,z:-1},turret.elevation),turret.yawRel),pose),barrelStart:barrelPoint(rig.barrelCapsule.start||{x:0,y:0,z:0}),barrelEnd:barrelPoint(rig.barrelCapsule.end||rig.muzzleLocal),turretOrigin:add(pose,hullVector(localTurret,pose)),hinge:add(pose,hullVector(localHinge,pose)),pose:{...pose},turret:{...turret}};\n' +
