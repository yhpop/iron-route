        '}\n',
      'src/tank-controller.js': '/** Deterministic, planar tracked drivetrain. Metres / seconds / radians; yaw 0 is -Z. */\n' +
        'const TAU = Math.PI * 2;\n' +
        'export const wrapAngle = value => ((value + Math.PI) % TAU + TAU) % TAU - Math.PI;\n' +
        'const finite = (value, fallback = 0) => Number.isFinite(value) ? value : fallback;\n' +
