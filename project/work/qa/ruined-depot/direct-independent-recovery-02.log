        '  raycast(from,to,ignoreIds=[]){\n' +
        "   if(disposed)throw new Error('Ruined depot world is disposed');if(![from.x,from.y,from.z,to.x,to.y,to.z].every(Number.isFinite))throw new TypeError('Finite segment required');\n" +
