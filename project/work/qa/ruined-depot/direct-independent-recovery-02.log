        "  world.setEntities?.([...Object.values(state.entities).filter(x=>x.alive||x.vehicle==='pz3').map(x=>x.vehicle==='pz3'?interceptorCollider(x):x),(state.mission.playerVehicle?playerCollider(state):{id:'tank',kind:'tank',pose:state.tank.pose,turret:state.tank.turret,width:1.9,depth:2.9,height:1.5})]);\n" +
