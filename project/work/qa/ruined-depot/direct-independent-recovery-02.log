        ' const base=createTerrainCombatWorld(spec,field),proxyIds=(spec.geometry||[]).filter(c=>c.ruinInstanceId).map(c=>c.id),instances=(spec.ruinedDepotLayout||RUINED_DEPOT_LAYOUT).map(i=>{\n' +
        '  const module=RUINED_DEPOT_COLLISION.modules[i.moduleId];if(!module)throw new Error(`Unknown ruin module ${i.moduleId}`);\n' +
        "  const triangles=module.triangles.map(t=>t.map(p=>ruinedDepotPoint(p,i))),points=triangles.flat(),bounds={min:{},max:{}};for(const k of ['x','y','z']){bounds.min[k]=Math.min(...points.map(p=>p[k]));bounds.max[k]=Math.max(...points.map(p=>p[k]));}return {id:i.id,triangles,bounds};\n" +
        ' });let disposed=false,destroyed=new Set();\n' +
