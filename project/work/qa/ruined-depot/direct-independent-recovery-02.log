        '  accel:1.3,coastDecel:1.2,brakeDecel:3.2,maxYawRate:.7,maxYawAccel:1.2,\n' +
        '  turretYawRate:1.1,elevationRate:.6,elevationLimits:[-8*Math.PI/180,25*Math.PI/180],\n' +
        '  recoilDistance:.08,recoilReturnSeconds:.2,\n' +
        '  rig:{\n' +
        '    hullProxy:{width:1.899625521,height:.784913416,depth:2.819320527,offset:{x:0,y:.392456705,z:-.000306512}},\n' +
        '    turretProxy:{width:1.547120,height:.637020,depth:1.502752,offset:{x:0,y:.277092,z:-.033338}},\n' +
        '    turretPivot:{x:0,y:1.6725492477416992*.455,z:-.11995315551757812*.455},\n' +
        '    barrelPivot:{x:0,y:.4000358581542969*.455,z:-1.2879886627197266*.455},\n' +
