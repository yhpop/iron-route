        ' const vehicle=(id,team,x,z,yaw,chargeTime,reload,range)=>{\n' +
        '  const ground=sampleGroundContact(field,x,z,yaw);\n' +
        "  return {id,kind:'turret',vehicle:'pz3',team,pose:{x,y:ground.height+.008,z,yaw},hp:110,protected:false,damage:12,chargeTime,reload,range,shieldArc:0,radius:2.2,width:1.921792,depth:3.532506,height:1.7,speed:0,travel:0};\n" +
        ' };\n' +
        " spec.entities.push(vehicle('allied-support','allied',-27,2,0,2.4,5,26),vehicle('hostile-flanker','hostile',-27,-19,Math.PI,2,4.2,22));\n" +
        " spec.design={...spec.design,teamEncounter:'allied support exchanges fire with hostile western flanker; neither is a victory target',supportRole:'temporary distraction, not invulnerable escort replacement',friendlyFireRule:'allied bodies absorb shells without friendly damage',newVehiclePositions:'stationary west of convoy centreline; persistent wrecks remain off lane'};\n" +
        ' return {spec,field};\n' +
        '}\n',
