        'export const rotateYaw = (p, yaw) => ({x:Math.cos(yaw)*p.x+Math.sin(yaw)*p.z,y:p.y,z:-Math.sin(yaw)*p.x+Math.cos(yaw)*p.z});\n' +
        'const rotateElevation = (p,a) => ({x:p.x,y:Math.cos(a)*p.y-Math.sin(a)*p.z,z:Math.sin(a)*p.y+Math.cos(a)*p.z});\n' +
        "const deepFreeze = value => { for (const child of Object.values(value)) if (child && typeof child === 'object') deepFreeze(child); return Object.freeze(value); };\n" +
        '\n' +
        '/** Conservative game-scale tuning, not claimed real-vehicle measurements. Proxies match the derivative V5 rig. */\n' +
        'export const DEFAULT_CONFIG = deepFreeze({\n' +
