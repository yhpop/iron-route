        '}\n',
      'src/scorched-front.js': "import {createVerticalSlice} from './terrain-candidate/vertical-slice.js';\n" +
        "import {sampleHeightfield} from './terrain-candidate/heightfield.js';\n" +
        '/** Isolated optional sortie. No edits to the campaign registry or old builders. */\n' +
        'export function createScorchedFront(){\n' +
        ' const {spec,field}=createVerticalSlice();\n' +
        " spec.id='mission-9040';spec.index=9040;spec.optional=true;spec.scorchedFront=true;spec.livingWorld=false;\n" +
        " spec.title='焦土货运站 · 穿越封锁';\n" +
        " spec.briefing='护送补给车穿过废弃货运站，到达北侧接应区。东侧硬路短，但装甲巡逻车封锁路口；西侧泥路较长，中央山脊可遮挡炮火。东路外沿的混凝土断墙是真实掩体，不能碾碎；西侧木栅仍可履带压开。按 H 或点车队待命，先侦察再让车队前进。远处烟柱只是环境，不会挡住敌人的视线。无需消灭所有敌人，别把敌车残骸堵在车队路线上。';\n" +
        ' const walls=[\n' +
        "  {id:'scorched-east-cover',x:19.5,z:9,width:.7,depth:4,height:1.8},\n" +
        "  {id:'scorched-east-low-wall',x:19.5,z:-4,width:.8,depth:3,height:1.05},\n" +
        "  {id:'scorched-west-remnant',x:-30,z:7,width:5,depth:.8,height:1.65}\n" +
        " ].map(c=>({...c,kind:'box',y:sampleHeightfield(field,c.x,c.z).height}));\n" +
        ' spec.geometry.push(...walls);\n' +
        " spec.sceneDressing={...spec.sceneDressing,appearance:'scorched',scorchedSources:[{id:'depot-soot',x:-27,z:29,baseHeight:4},{id:'garage-soot',x:28,z:-31,baseHeight:3.2}]};\n" +
        " spec.design={...spec.design,ecologyRole:'none: barren industrial ground',environmentRole:'solid cover and cosmetic distant smoke; no smoke occlusion or fire damage',terrainChange:'none; original shared field retained',newCoverIds:walls.map(c=>c.id)};\n" +
        ' return {spec,field};\n' +
        '}\n',
      'src/sentry-rig.js': "import {INTERCEPTOR_RIG} from './interceptor.js';\n" +
        '/** Measured from sentry-turret.glb. Plain-data shared combat/render contract.\n' +
        ' * +Y up, -Z forward; yaw +Y, elevation +X, recoil +Z. No collider change. */\n' +
        'export const SENTRY_RIG=Object.freeze({yawHeight:1.1299999952316284,pitchHeight:.1499999761581421,pitchForward:.20740000903606415,barrelLength:.5489999651908875,minElevation:-.08,maxElevation:.35,maxRecoil:.07});\n' +
        'const clamp=(n,a,b)=>Math.max(a,Math.min(b,n));\n' +
        'export function sentryAim(entity,target){\n' +
        " const rig=entity.vehicle==='pz3'?INTERCEPTOR_RIG:SENTRY_RIG;\n" +
        ' const p=entity.pose,dx=target.x-p.x,dz=target.z-p.z;\n' +
        ' return {yaw:Math.atan2(-dx,-dz),elevation:clamp(Math.atan2(target.y-p.y-rig.yawHeight-rig.pitchHeight,Math.max(.001,Math.hypot(dx,dz)-rig.pitchForward)),rig.minElevation,rig.maxElevation)};\n' +
        '}\n' +
        'export function sentryMuzzleTransform(entity,recoil=0){\n' +
        " const r=entity.vehicle==='pz3'?INTERCEPTOR_RIG:SENTRY_RIG,p=entity.pose,yaw=entity.aimYaw??p.yaw??0,elevation=entity.aimElevation??0;\n" +
        ' const length=r.barrelLength-clamp(recoil,0,r.maxRecoil),forward=r.pitchForward+length*Math.cos(elevation);\n' +
