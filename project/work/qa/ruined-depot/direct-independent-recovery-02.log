        '    // Get relative xy coordinates of point within that cell\n' +
        '    x = x - X;\n' +
        '    y = y - Y;\n' +
        '    // Wrap the integer cells at 255 (smaller integer period can be introduced here)\n' +
        '    X = X & 255;\n' +
        '    Y = Y & 255;\n' +
        '\n' +
        '    // Calculate noise contributions from each of the four corners\n' +
        '    var n00 = gradP[X+perm[Y]].dot2(x, y);\n' +
