        '    }\n' +
        '    var t1 = 0.5 - x1*x1-y1*y1;\n' +
        '    if (t1 < 0) {\n' +
        '        n1 = 0;\n' +
        '    }\n' +
        '    else {\n' +
        '        t1 *= t1;\n' +
