        " spec.design={...spec.design,teamEncounter:'allied support exchanges fire with hostile western flanker; neither is a victory target',supportRole:'temporary distraction, not invulnerable escort replacement',friendlyFireRule:'allied bodies absorb shells without friendly damage',newVehiclePositions:'stationary west of convoy centreline; persistent wrecks remain off lane'};\n" +
        ' return {spec,field};\n' +
        '}\n',
