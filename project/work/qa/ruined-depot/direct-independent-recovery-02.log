        "import {RUINED_DEPOT_LAYOUT,ruinedDepotPoint} from './ruined-depot-layout.js';\n" +
        'const sub=(a,b)=>({x:a.x-b.x,y:a.y-b.y,z:a.z-b.z}),dot=(a,b)=>a.x*b.x+a.y*b.y+a.z*b.z,cross=(a,b)=>({x:a.y*b.z-a.z*b.y,y:a.z*b.x-a.x*b.z,z:a.x*b.y-a.y*b.x});\n' +
        "function intersectsBounds(a,d,b){let lo=0,hi=1;for(const k of ['x','y','z']){if(Math.abs(d[k])<1e-12){if(a[k]<b.min[k]-1e-9||a[k]>b.max[k]+1e-9)return false;}else{let n=(b.min[k]-a[k])/d[k],f=(b.max[k]-a[k])/d[k];if(n>f)[n,f]=[f,n];lo=Math.max(lo,n);hi=Math.min(hi,f);if(lo>hi+1e-9)return false;}}return true;}\n" +
        'function triangleHit(a,d,tri){const [p,q,r]=tri,e=sub(q,p),v=sub(r,p),h=cross(d,v),det=dot(e,h);if(Math.abs(det)<1e-12)return null;const s=sub(a,p),u=dot(s,h)/det;if(u< -1e-9||u>1+1e-9)return null;const k=cross(s,e),w=dot(d,k)/det;if(w< -1e-9||u+w>1+1e-9)return null;const t=dot(v,k)/det;if(t< -1e-9||t>1+1e-9)return null;const normal=cross(e,v),length=Math.hypot(normal.x,normal.y,normal.z);if(length<1e-12)return null;const sign=dot(normal,d)>0?-1:1;return {fraction:Math.max(0,Math.min(1,t)),normal:{x:sign*normal.x/length,y:sign*normal.y/length,z:sign*normal.z/length}};}\n' +
        '/** New-mission composition only. Movement remains original production queries.\n' +
