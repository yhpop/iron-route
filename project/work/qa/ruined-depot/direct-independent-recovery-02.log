        '    tankCombat: createCombatState(mission), entities: initializeEntities(mission), projectiles: [],\n' +
        '    objectiveStates: createObjectiveStates(mission), events: [], result: null, nextEventId: 1, nextProjectileId: 1,\n' +
        "    ...(mission.convoyCommands === true ? { convoyOrder: 'advance' } : {}),\n" +
        "    ...(Object.hasOwn(mission, 'convoyChoice') ? { selectedConvoyChoiceId: null } : {}) };\n" +
        '}\n' +
        '\n' +
        'function nextDraft(previous) {\n' +
