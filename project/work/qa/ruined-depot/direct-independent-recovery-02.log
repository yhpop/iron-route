        '  const position=barrelPoint(rig.muzzleLocal);\n' +
        '  return {\n' +
        '    position,direction:rotateYaw(rotateElevation({x:0,y:0,z:-1},turret.elevation),yaw),\n' +
        '    barrelStart:barrelPoint(rig.barrelCapsule.start || {x:0,y:0,z:0}),\n' +
        '    barrelEnd:barrelPoint(rig.barrelCapsule.end || rig.muzzleLocal),\n' +
        '    turretOrigin,hinge,pose:{...pose},turret:{...turret},\n' +
        '  };\n' +
        '}\n' +
        '\n' +
        '/** Exact constant-curvature integration: no independent world-axis velocity and therefore no strafing. */\n' +
        'export function integrateArc(pose, distance, angle) {\n' +
        '  if(Math.abs(angle)<1e-9) return {...pose,x:pose.x-Math.sin(pose.yaw)*distance,z:pose.z-Math.cos(pose.yaw)*distance,yaw:wrapAngle(pose.yaw+angle)};\n' +
        '  const end=pose.yaw+angle,r=distance/angle;\n' +
        '  return {...pose,x:pose.x+r*(Math.cos(end)-Math.cos(pose.yaw)),z:pose.z-r*(Math.sin(end)-Math.sin(pose.yaw)),yaw:wrapAngle(end)};\n' +
        '}\n' +
        '\n' +
        'function frameFor(state, rig, dt, deltaTrackL, deltaTrackR, canFire, contacts, desiredSpeed, boostActive, surface) {\n' +
        '  return {\n' +
        '    pose:{...state.pose},turretYawRel:state.turret.yawRel,elevation:state.turret.elevation,recoil:state.turret.recoil,\n' +
        '    muzzleWorld:getTankTransform(state,rig),deltaTrackL,deltaTrackR,trackL:state.trackL,trackR:state.trackR,\n' +
        '    speedForward:(state.vL+state.vR)/2,yawRate:dt>0?wrapAngle(state.pose.yaw-(state._previousYaw??state.pose.yaw))/dt:0,\n' +
        '    canFire,contacts:[...new Set(contacts)],desiredSpeed,governor:state.governor,boostActive,surface,\n' +
        '  };\n' +
        '}\n' +
        '\n' +
        'export function stepTank(previous, rawInput = {}, dt = 1/60, env, config = DEFAULT_CONFIG) {\n' +
        "  if(!Number.isFinite(dt) || dt<=0 || dt>.1) throw new RangeError('Tank dt must be finite, positive, and <= 0.1 seconds; use a fixed-step accumulator');\n" +
        '  const state={...previous,pose:{...previous.pose},turret:{...previous.turret},blocked:{...previous.blocked}};\n' +
        '  const input=rawInput || {};\n' +
        '  const clearance = transform => env?.muzzleClear ? env.muzzleClear(transform,config.rig) : true;\n' +
        "  const isClear = result => typeof result==='boolean'?result:(result?.clear??!result?.blocked);\n" +
        '  // Centre-point polygon sampling is deliberately game-scale, not simulated track slip.\n' +
        '  // Surface transitions change targets and slew limits; they never assign stored speed.\n' +
        "  const sampled=env?.surfaceAt?.(state.pose)||{id:null,class:'road',traction:1,drag:1};\n" +
        '  const traction=clamp(finite(sampled.traction,1),.35,1),drag=clamp(finite(sampled.drag,1),1,2.5);\n' +
        '  const speedMultiplier=clamp(traction/Math.sqrt(drag),.45,1),turnMultiplier=.7+.3*traction;\n' +
        "  const surface={id:sampled.id??null,class:sampled.class||'road',traction,drag,speedMultiplier,accelerationMultiplier:traction,turnMultiplier};\n" +
        '  if(input.paused) return {state,frame:frameFor(state,config.rig,dt,0,0,isClear(clearance(getTankTransform(state,config.rig))),[],0,false,surface),events:[]};\n' +
        '  if(Object.hasOwn(config.governorCaps,input.governor)) state.governor=input.governor;\n' +
