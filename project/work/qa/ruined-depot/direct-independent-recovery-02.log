        '}\n' +
        '\n' +
        'export function hullVector(v,pose,inverse=false){\n' +
        ' const b=pose.basis;if(!b)return rotateYaw(v,inverse?-pose.yaw:pose.yaw);\n' +
        ' if(inverse){const q=rotateYaw(v,-pose.yaw);return {x:q.x*b.right[0]+q.y*b.right[1]+q.z*b.right[2],y:q.x*b.up[0]+q.y*b.up[1]+q.z*b.up[2],z:q.x*b.forward[0]+q.y*b.forward[1]+q.z*b.forward[2]};}\n' +
        ' return rotateYaw({x:b.right[0]*v.x+b.up[0]*v.y+b.forward[0]*v.z,y:b.right[1]*v.x+b.up[1]*v.y+b.forward[1]*v.z,z:b.right[2]*v.x+b.up[2]*v.y+b.forward[2]*v.z},pose.yaw);\n' +
        '}\n' +
        '/** The same hull -> yaw pivot -> elevation hinge -> recoil slide chain used by the visual rig. */\n' +
        'export function getTankTransform(tank, rig = DEFAULT_CONFIG.rig) {\n' +
        '  const pose=tank.pose, turret=tank.turret;\n' +
        '  if(pose.basis){\n' +
