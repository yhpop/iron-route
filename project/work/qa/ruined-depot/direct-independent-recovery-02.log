      'src/scanned-cover-front.js': "import {createCrossfireV4Front} from './crossfire-v4-front.js';\n" +
        "import {sampleHeightfield} from './terrain-candidate/heightfield.js';\n" +
        "export const SCANNED_COVER_IDS=Object.freeze(['scan-east-entry','scan-east-mid','scan-west-shoulder']);\n" +
        '/** Exact scan envelope: box collision intentionally fills chips and lifting loops. */\n' +
        'export function createScannedCoverFront(){\n' +
