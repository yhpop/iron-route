ield,e.pose.x,e.pose.z).height;\n const spec={schema:1,id:'mission-9005',index:9005,optional:true,terrainCombat:true,districtId:'south-wharf',title:'堤路护送 · 山脊与双线',\n briefing:'把补给车带到北部接应区，而不是清空所有炮位。驶入东侧金圈选硬路：路短，但会暴露在炮位前；驶入西侧金圈选低地土路：路长，中央山脊能挡弹，入口木栅须用履带压开。选路后锁定。可点“车队待命”或按 H 把车留在掩体后，绕侧清炮后再按“继续护送”；待命时敌火不会暂停。补给车会等待你靠近，也会停在未清障碍或你的车身后。可先清炮位，再回车队，也可边走边护送。山脊后的北炮位需绕侧才能击中，正面装甲会挡弹。',\n bounds,spawn:{x:0,y:0,z:23,yaw:0},geometry,entities,\n routes:roads.map(r=>({id:r.id,width:r.width,points:r.points.map(([x,z])=>({x,z}))})),\n zones:[rect('orders',0,23,8,6),rect('choose-east',8,19,5,6),rect('choose-west',-8,19,5,6),rect('rendezvous',0,-32,10,8)],\n objectives:[{id:'receive-orders',type:'reach',requires:[],nextIds:['escort-supply'],targetIds:[],zoneId:'orders',title:'接应补给车，驶入东西集结圈选路'},\n {id:'escort-supply',type:'escort',requires:['receive-orders'],nextIds:[],targetIds:['supply'],zoneId:'rendezvous',title:'护送补给车进入北部接应区'}],\n convoyCommands:true,\n convoyChoice:{requiresObjectiveId:'receive-orders',prompt:'右侧硬路：短但暴露；左侧低地：长但有山脊掩护。驶入金圈锁定路线',options:[{id:'direct',title:'东侧硬路',zoneId:'choose-east',routeByTruck:{supply:'ridge-east'}},{id:'covered',title:'西侧低地土路',zoneId:'choose-west',routeByTruck:{supply:'ridge-west'}}]},\n sceneDressing:{schema:1,districtId:'south-wharf',ground:{material:'concrete'},roads,landmarks:[{geometryId:'south-depot',assetKey:'warehouse-sawtooth',role:'Departure depot'},{geometryId:'west-workshop',assetKey:'service-workshop',role:'Low road marker'},{geometryId:'north-garage',assetKey:'service-workshop',role:'Rendezvous landmark'}],props:[],water:[],drains:[]},\n design:{targetSeconds:[150,300],evidence:{humanPlaythrough:'unverified',combatBalance:'unverified'},terrainProof:{blockedPose:{x:8,z:-2,yaw:0},exposedPose:{x:14,z:-18,yaw:0},targetId:'ridge-gun'}}};\n return {spec,field};\n}\n", 'src/terrain-candidate/vendor/three-terrain/noise.js': "/**\n* Simplex and Perlin noise.\n*\n* Copied with small edits from https://github.com/josephg/noisejs which is\n* public domain. Originally by Stefan Gustavson (stegu@itn.liu.se) with\n* optimizations by Peter Eastman (peastman@drizzle.stanford.edu) and converted\n* to JavaScript by Joseph Gentle.\n*/\n\n// Create noise module object that we'll export\nconst noise = {};\n\nfunction Grad(x, y, z) {\n    this.x = x;\n    this.y = y;\n    this.z = z;\n}\n\nGrad.prototype.dot2 = function(x, y) {\n    return this.x*x + this.y*y;\n};\n\nGrad.prototype.dot3 = function(x, y, z) {\n    return this.x*x + this.y*y + this.z*z;\n};\n\nvar grad3 = [\n    new Grad(1,1,0),new Grad(-1,1,0),new Grad(1,-1,0),new Grad(-1,-1,0),\n    new Grad(1,0,1),new Grad(-1,0,1),new Grad(1,0,-1),new Grad(-1,0,-1),\n    new Grad(0,1,1),new Grad(0,-1,1),new Grad(0,1,-1),new Grad(0,-1,-1),\n];\n\nvar p = [151,160,137,91,90,15,131,13,201,95,96,53,194,233,7,225,140,36,103,\n    30,69,142,8,99,37,240,21,10,23,190,6,148,247,120,234,75,0,26,197,62,94,\n    252,219,203,117,35,11,32,57,177,33,88,237,149,56,87,174,20,125,136,171,\n    168,68,175,74,165,71,134,139,48,27,166,77,146,158,231,83,111,229,122,\n    60,211,133,230,220,105,92,41,55,46,245,40,244,102,143,54,65,25,63,161,\n    1,216,80,73,209,76,132,187,208,89,18,169,200,196,135,130,116,188,159,\n    86,164,100,109,198,173,186,3,64,52,217,226,250,124,123,5,202,38,147,\n    118,126,255,82,85,212,207,206,59,227,47,16,58,17,182,189,28,42,223,183,\n    170,213,119,248,152,2,44,154,163,70,221,153,101,155,167,43,172,9,129,\n    22,39,253,19,98,108,110,79,113,224,232,178,185,112,104,218,246,97,228,\n    251,34,242,193,238,210,144,12,191,179,162,241,81,51,145,235,249,14,239,\n    107,49,192,214,31,181,199,106,157,184,84,204,176,115,121,50,45,127,4,\n    150,254,138,236,205,93,222,114,67,29,24,72,243,141,128,195,78,66,215,\n    61,156,180];\n// To avoid the need for index wrapping, double the permutation table length\nvar perm = new Array(512),\n    gradP = new Array(512);\n\n// This isn't a very good seeding function, but it works okay. It supports\n// 2^16 different seed values. Write your own if you need more seeds.\nnoise.seed = function(seed) {\n    if (seed > 0 && seed < 1) {\n        // Scale the seed out\n        seed *= 65536;\n    }\n\n    seed = Math.floor(seed);\n    if (seed < 256) {\n        seed |= seed << 8;\n    }\n\n    for (var i = 0; i < 256; i++) {\n        var v;\n        if (i & 1) {\n            v = p[i] ^ (seed & 255);\n        }\n        else {\n            v = p[i] ^ ((seed>>8) & 255);\n        }\n\n        perm[i] = perm[i + 256] = v;\n        gradP[i] = gradP[i + 256] = grad3[v % 12];\n    }\n};\n\n// Seed with random value if not set elsewhere\nnoise.seed(Math.random());\n\n// Skewing and unskewing factors for 2 and 3 dimensions\nvar F2 = 0.5*(Math.sqrt(3)-1),\n    G2 = (3-Math.sqrt(3))/6,\n    F3 = 1/3,\n    G3 = 1/6;\n\n// 2D simplex noise\nnoise.simplex = function(xin, yin) {\n    var n0, n1, n2; // Noise contributions from the three corners\n    // Skew the input space to determine which simplex cell we're in\n    var s = (xin+yin)*F2; // Hairy factor for 2D\n    var i = Math.floor(xin+s);\n    var j = Math.floor(yin+s);\n    var t = (i+j)*G2;\n    var x0 = xin-i+t; // The x,y distances from the cell origin, unskewed\n    var y0 = yin-j+t;\n    // For the 2D case, the simplex shape is an equilateral triangle.\n    // Determine which simplex we are in.\n    var i1, j1; // Offsets for second (middle) corner of simplex in (i,j) coords\n    if (x0 > y0) { // Lower triangle, XY order: (0,0)->(1,0)->(1,1)\n        i1 = 1; j1 = 0;\n    }\n    else { // Upper triangle, YX order: (0,0)->(0,1)->(1,1)\n        i1 = 0; j1 = 1;\n    }\n    // A step of (1,0) in (i,j) means a step of (1-c,-c) in (x,y), and\n    // a step of (0,1) in (i,j) means a step of (-c,1-c) in (x,y), where\n    // c = (3-sqrt(3))/6\n    var x1 = x0 - i1 + G2; // Offsets for middle corner in (x,y) unskewed coords\n    var y1 = y0 - j1 + G2;\n    var x2 = x0 - 1 + 2 * G2; // Offsets for last corner in (x,y) unskewed coords\n    var y2 = y0 - 1 + 2 * G2;\n    // Work out the hashed gradient indices of the three simplex corners\n    i &= 255;\n    j &= 255;\n    var gi0 = gradP[i+perm[j]];\n    var gi1 = gradP[i+i1+perm[j+j1]];\n    var gi2 = gradP[i+1+perm[j+1]];\n    // Calculate the contribution from the three corners\n    var t0 = 0.5 - x0*x0-y0*y0;\n    if (t0 < 0) {\n        n0 = 0;\n    }\n    else {\n        t0 *= t0;\n        n0 = t0 * t0 * gi0.dot2(x0, y0); // (x,y) of grad3 used for 2D gradient\n    }\n    var t1 = 0.5 - x1*x1-y1*y1;\n    if (t1 < 0) {\n        n1 = 0;\n    }\n    else {\n        t1 *= t1;\n        n1 = t1 * t1 * gi1.dot2(x1, y1);\n    }\n    var t2 = 0.5 - x2*x2-y2*y2;\n    if (t2 < 0) {\n        n2 = 0;\n    }\n    else {\n        t2 *= t2;\n        n2 = t2 * t2 * gi2.dot2(x2, y2);\n    }\n    // Add contributions from each corner to get the final noise value.\n    // The result is scaled to return values in the interval [-1,1].\n    return 70 * (n0 + n1 + n2);\n};\n\n// ##### Perlin noise stuff\n\nfunction fade(t) {\n    return t*t*t*(t*(t*6-15)+10);\n}\n\nfunction lerp(a, b, t) {\n    return (1-t)*a + t*b;\n}\n\n// 2D Perlin Noise\nnoise.perlin = function(x, y) {\n    // Find unit grid cell containing point\n    var X = Math.floor(x),\n        Y = Math.floor(y);\n    // Get relative xy coordinates of point within that cell\n    x = x - X;\n    y = y - Y;\n    // Wrap the integer cells at 255 (smaller integer period can be introduced here)\n    X = X & 255;\n    Y = Y & 255;\n\n    // Calculate noise contributions from each of the four corners\n    var n00 = gradP[X+perm[Y]].dot2(x, y);\n    var n01 = gradP[X+perm[Y+1]].dot2(x, y-1);\n    var n10 = gradP[X+1+perm[Y]].dot2(x-1, y);\n    var n11 = gradP[X+1+perm[Y+1]].dot2(x-1, y-1);\n\n    // Compute the fade curve value for x\n    var u = fade(x);\n\n    // Interpolate the four results\n    return lerp(\n        lerp(n00, n10, u),\n        lerp(n01, n11, u),\n        fade(y)\n    );\n};\n\n// Export the noise module\nexport { noise };\n\n", 'src/terrain-candidate/vertical-slice.js': "import {createInterceptorMission} from './interceptor-mission.js';\n/** One coherent escort encounter; no changes to the authored campaign registry. */\nexport function createVerticalSlice(){\n const {spec,field}=createInterceptorMission();\n spec.id='mission-9030';spec.index=9030;spec.livingWorld=true;\n spec.title='林脊伏击 · 补给线';\n spec.briefing='任务是把补给车送到北部接应区，不必消灭所有敌人。先选路线：东侧硬路短，装甲巡逻车会在装填时沿路转移；西侧低地绕远，但中央山脊能挡住炮火，入口木栅可以履带压开。按 H 或点车队待命，先独自侦察，再回到车队附近继续护送。北端固定炮位封锁会合口，留意预警，借掩体绕侧或趁装填通过。不要把敌车残骸打在车队路线上；残骸会挡车挡弹。草地与狐狸不是掩体，也不需要攻击；履带会压弯草，附近炮声会惊走狐狸。';\n spec.design={...spec.design,integratedSlice:true,ecologyRole:'noncombat ambience, no collision or cover',enemyRole:'mobile east-road denial; north fixed overwatch',victoryRule:'escort only, no kill quota'};\n return {spec,field};\n}\n" },
