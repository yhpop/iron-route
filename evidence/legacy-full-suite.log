chargeElapsed: 0, cooldown: 0, telegraphTarget: null, targetId: null });\n    entities[entity.id] = entity;\n  }\n  return entities;\n}\n\nexport function syncWorldEntities(state, world) {\n  world.setEntities?.([...Object.values(state.entities).filter(e => (e.alive || e.vehicle==='pz3') && e.kind !== 'barrier').map(e=>e.vehicle==='pz3'?interceptorCollider(e):e), playerCollider(state)]);\n}\n\nexport function destroyedColliderIds(state) {\n  return Object.values(state.entities).filter(e => e.kind === 'barrier' && !e.alive).map(e => e.id);\n}\n\n// Segment against an upright oriented box, using all three axes (not a ground-plane ray).\nfunction segmentBox(from, to, pose, width, depth, height) {\n  const c = Math.cos(pose.yaw), s = Math.sin(pose.yaw);\n  const local = p => ({ x: c * (p.x - pose.x) - s * (p.z - pose.z), y: p.y - pose.y, z: s * (p.x - pose.x) + c * (p.z - pose.z) });\n  const a = local(from), b = local(to); let lo = 0, hi = 1;\n  for (const [axis, min, max] of [['x', -width / 2, width / 2], ['y', 0, height], ['z', -depth / 2, depth / 2]]) {\n    const d = b[axis] - a[axis];\n    if (Math.abs(d) < 1e-9) { if (a[axis] < min || a[axis] > max) return null; continue; }\n    let t0 = (min - a[axis]) / d, t1 = (max - a[axis]) / d;\n    if (t0 > t1) [t0, t1] = [t1, t0];\n    lo = Math.max(lo, t0); hi = Math.min(hi, t1); if (lo > hi) return null;\n  }\n  return lo;\n}\n\nfunction segmentCylinder(from, to, entity) {\n  const dx = to.x - from.x, dz = to.z - from.z, ox = from.x - entity.pose.x, oz = from.z - entity.pose.z;\n  const a = dx * dx + dz * dz, b = 2 * (ox * dx + oz * dz), c = ox * ox + oz * oz - entity.radius ** 2;\n  let lo = 0, hi = 1;\n  if (a < 1e-12) { if (c > 0) return null; }\n  else {\n    const disc = b * b - 4 * a * c; if (disc < 0) return null;\n    const root = Math.sqrt(disc); lo = Math.max(lo, (-b - root) / (2 * a)); hi = Math.min(hi, (-b + root) / (2 * a));\n  }\n  const dy = to.y - from.y, minY = entity.pose.y, maxY = minY + entity.height;\n  if (Math.abs(dy) < 1e-9) { if (from.y < minY || from.y > maxY) return null; }\n  else { let t0 = (minY - from.y) / dy, t1 = (maxY - from.y) / dy; if (t0 > t1) [t0, t1] = [t1, t0]; lo = Math.max(lo, t0); hi = Math.min(hi, t1); }\n  return lo <= hi ? lo : null;\n}\n\nfunction nearestHit(state, shot, from, to, world) {\n  const geometry = world.raycast?.(from, to, [shot.ownerId]) ?? null;\n  let best = geometry ? { id: geometry.id ?? geometry.colliderId, fraction: geometry.fraction ?? geometry.distance / Math.max(1e-9, distance(from, to)), point: geometry.point ?? geometry.position, normal: geometry.normal } : null;\n  for (const entity of Object.values(state.entities)) {\n    if (!entity.alive || entity.id === shot.ownerId || entity.kind === 'barrier') continue;\n    const t = entity.vehicle==='pz3' && world.raycast ? null : (entity.kind === 'truck' || entity.vehicle==='pz3') ? segmentBox(from, to, entity.pose, entity.width, entity.depth, entity.height) : segmentCylinder(from, to, entity);\n    if (t !== null && (!best || t < best.fraction)) best = { id: entity.id, fraction: t, point: pointAt(from, to, t) };\n  }\n  if (shot.ownerId !== 'tank' && !world.terrain && (!state.mission.playerVehicle || !world.raycast)) {\n    const body=playerBody(state.mission);\n    const t = segmentBox(from, to, state.tank.pose, body.width, body.depth, body.height);\n    if (t !== null && (!best || t < best.fraction)) best = { id: 'tank', fraction: t, point: pointAt(from, to, t) };\n  }\n  if (best && !best.point) best.point = pointAt(from, to, best.fraction);\n  return best;\n}\n\nfunction shielded(entity, shot) {\n  if (!(entity.shieldArc > 0) || entity.kind === 'truck') return false;\n  const length = Math.hypot(shot.velocity.x, shot.velocity.z); if (length < 1e-9) return false;\n  const towardShooter = (-Math.sin(entity.pose.yaw) * -shot.velocity.x - Math.cos(entity.pose.yaw) * -shot.velocity.z) / length;\n  return towardShooter > Math.cos(entity.shieldArc / 2) + 1e-7;\n}\n\nfunction applyHit(state, shot, hit, world) {\n  const entity = state.entities[hit.id];\n  if(absorbsFriendlyHit(state,shot,hit.id)){emitEvent(state,'impact',{entityId:shot.ownerId,targetId:hit.id,position:hit.point,...(hit.normal?{normal:{...hit.normal}}:{}),projectileId:shot.id,value:'friendly-block'});return;}\n  const blocked = entity?.alive && shielded(entity, shot);\n  emitEvent(state, 'impact', { entityId: shot.ownerId, targetId: hit.id, position: hit.point, ...(hit.normal?{normal:{...hit.normal}}:{}), projectileId:shot.id, value: blocked ? 'shield' : 'hit' });\n  if (blocked) return;\n  if (hit.id === 'tank') {\n    const dealt = Math.min(state.tankCombat.hp, shot.damage);\n    state.tankCombat.hp -= dealt; state.tankCombat.damageTaken += dealt;\n    emitEvent(state, 'damaged', { targetId: 'tank', entityId: shot.ownerId, position: hit.point, value: dealt });\n    if (state.tankCombat.hp === 0) emitEvent(state, 'destroyed', { entityId: 'tank', position: hit.point });\n  } else if (entity?.alive) {\n    const dealt = Math.min(entity.hp, shot.damage); entity.hp -= dealt;\n    emitEvent(state, 'damaged', { targetId: entity.id, entityId: shot.ownerId, position: hit.point, value: dealt });\n    if (entity.hp === 0) {\n      entity.alive = false; entity.destroyed = true; entity.status = 'destroyed'; entity.charge = 0; entity.telegraphTarget = null; entity.speed = 0;\n      emitEvent(state, 'destroyed', { entityId: entity.id, position: entity.pose });\n      syncWorldEntities(state, world);\n      if (entity.kind === 'barrier') { world.setDestroyed?.(destroyedColliderIds(state)); emitEvent(state, 'barrier-opened', { entityId: entity.id, position: entity.pose }); }\n    }\n  }\n}\n\nfunction addProjectile(state, ownerId, faction, position, direction, speed, damage) {\n  const unit = normalized(direction); if (!unit) return false;\n  state.nextProjectileId = finite(state.nextProjectileId, 1);\n  const id = `projectile-${state.nextProjectileId++}`;\n  state.projectiles.push({ id, ownerId, faction, position: { ...position }, previousPosition: { ...position }, velocity: { x: unit.x * speed, y: unit.y * speed, z: unit.z * speed }, damage, life: COMBAT_CONFIG.projectileLife });\n  emitEvent(state, 'shot', { entityId: ownerId, position: { ...position }, projectileId: id });\n  return true;\n}\n\nfunction active(entity, state) {\n  if (!entity.activationObjectiveId) return true;\n  const objective = state.objectiveStates?.[entity.activationObjectiveId];\n  return objective?.status === 'complete' || (entity.activationPhase === 'active' && objective?.status === 'active');\n}\n\nfunction stepTurrets(state, dt, world) {\n  for (const entity of Object.values(state.entities)) {\n    if (!entity.alive || !['turret', 'drone'].includes(entity.kind)) continue;\n    if (!active(entity, state)) { entity.status = 'idle'; entity.charge = 0; continue; }\n    entity.cooldown = Math.max(0, entity.cooldo"... 3949 more characters, 'src/crossfire-front.js': "import {createScorchedFront} from './scorched-front.js';\nimport {sampleGroundContact} from './terrain-candidate/heightfield.js';\n/** Optional team encounter; the original sortie and its terrain/routes remain unchanged.\n * Support delays a western flanker, but neither vehicle is an escort objective.\n * Static positions keep live vehicles and persistent wrecks off the convoy lane.\n * Unshielded 110HP/12-damage combat leaves a readable exchange, not an instant kill.\n */\nexport function createCrossfireFront(){\n const {spec,field}=createScorchedFront();\n spec.id='mission-9050';spec.index=9050;spec.crossfireFront=true;\n spec.title='焦土交叉火线 · 协同护送';\n spec.briefing='护送补给车穿过焦土货运站，到达北侧接应区。蓝方支援车在西路外侧牵制敌方侧翼车，双方会真实交火；支援车不是护送目标，损失它不会直接失败。东侧硬路短但有敌车封锁，西侧绕行可借山脊掩护。按 H 或点车队待命，先侦察再推进。友军会挡住炮弹：不要朝补给车或支援车开火，也不要挡在友军炮口前。无需消灭所有敌人，别让敌车残骸堵住车队路线。';\n spec.combatRelations={version:1,playerTeam:'allied',teams:['allied','hostile'],hostilePairs:[['allied','hostile'],['hostile','allied']],friendlyFire:'absorb'};\n spec.entities=spec.entities.map(e=>({...e,team:e.kind==='truck'?'allied':'hostile'}));\n const vehicle=(id,team,x,z,yaw,chargeTime,reload,range)=>{\n  const ground=sampleGroundContact(field,x,z,yaw);\n  return {id,kind:'turret',vehicle:'pz3',team,pose:{x,y:ground.height+.008,z,yaw},hp:110,protected:false,damage:12,chargeTime,reload,range,shieldArc:0,radius:2.2,width:1.921792,depth:3.532506,height:1.7,speed:0,travel:0};\n };\n spec.entities.push(vehicle('allied-support','allied',-27,2,0,2.4,5,26),vehicle('hostile-flanker','hostile',-27,-19,Math.PI,2,4.2,22));\n spec.design={...spec.design,teamEncounter:'allied support exchanges fire with hostile western flanker; neither is a victory target',supportRole:'temporary distraction, not invulnerable escort replacement',friendlyFireRule:'allied bodies absorb shells without friendly damage',newVehiclePositions:'stationary west of convoy centreline; persistent wrecks remain off lane'};\n return {spec,field};\n}\n", 'src/crossfire-v3-front.js': "import {createCrossfireFront} from './crossfire-front.js';\nimport {sampleGroundContact} from './terrain-candidate/heightfield.js';\n/** Independent V3 encounter. Static support/flanker use the unchanged real combat\n * system; this builder adds neither mobile AI nor scripted/fake fire. V2 stays frozen. */\nexport function createCrossfireV3Front(){\n const {spec,field}=createCrossfireFront();\n spec.id='mission-9051';spec.index=9051;spec.crossfireV3=true;\n spec.title='焦土交叉火线 V3 · 前沿接应';\n spec.briefing='护送补给车到达北侧接应区。开局左前方的蓝方支援车与敌方侧翼车会真实交火；两车在路外固定阵位，支援车不是护送目标，损失它不会直接失败。东侧硬路短但有敌车封锁，西侧绕行可借山脊掩护。按 H 或点车队待命，先侦察再推进。友军会挡住炮弹：不要朝补给车或支援车开火，也不要挡在友军炮口前。无需消灭所有敌人，别让敌车残骸堵住车队路线。';\n const positions={'allied-support':{x:-4,z:18},'hostile-flanker':{x:-10,z:9}};\n spec.entities=spec.entities.map(e=>{const p=positions[e.id];if(!p)return e;const other=positions[e.id==='allied-support'?'hostile-flanker':'allied-support'],yaw=Math.atan2(-(other.x-p.x),-(other.z-p.z)),ground=sampleGroundContact(field,p.x,p.z,yaw);return {...e,pose:{...p,y:ground.height+.008,yaw}};});\n spec.design={...spec.design,teamEncounter:'visible opening exchange between two stationary off-lane real combat vehicles',supportRole:'static temporary distraction; no mobile AI or escort objective',newVehiclePositions:'opening southwest shoulder clear of both convoy route corridors; persistent wrecks stay off lane',openingEvidence:'offline production simulation and exact main-camera projections; not a device render pass'};\n return {spec,field};\n}\n", 'src/crossfire-v4-front.js': "import {createCrossfireV3Front} from './crossfire-v3-front.js';\nimport {sampleGroundContact} from './terrain-candidate/heightfield.js';\n/** Independent opt-in V4: the existing combatants use production collision-swept\n * PzIII patrols. Weapons, terrain, convoy routes and the five chassis are unchanged.\n * Short routes were selected by actual 30-second compound-sweep/combat evidence. */\nexport function createCrossfireV4Front(){\n const {spec,field}=createCrossfireV3Front();\n spec.id='mission-9052';spec.index=9052;spec.crossfireV4=true;\n spec.title='焦土交叉火线 V4 · 机动接应';\n spec.briefing='护送补给车到达北侧接应区。开局前方的蓝方支援车与敌方侧翼车会真实交火；两车会在装填间歇沿短路线机动，瞄准蓄力时停车，遇到障碍也会停下。支援车不是护送目标，损失它不会直接失败。东侧硬路短但有敌车封锁，西侧绕行可借山脊掩护。按 H 或点车队待命，先侦察再推进。友军会挡住炮弹：不要朝补给车或支援车开火，也不要挡在友军炮口前。无需消灭所有敌人，别让敌车残骸堵住车队路线。';\n const patrols={'allied-support':[{x:-4,z:18},{x:-5,z:16}],'hostile-flanker':[{x:1.2,z:16},{x:0,z:16}]};\n // V4-only relocation avoids the inherited steep ridge: the authored PzIII\n // view is upright, so terrain fit was checked against its real mesh + treads.\n const support=spec.entities.find(e=>e.id==='allied-support').pose,p={x:1.2,z:16},yaw=Math.atan2(-(support.x-p.x),-(support.z-p.z)),ground=sampleGroundContact(field,p.x,p.z,yaw);\n spec.entities=spec.entities.map(e=>patrols[e.id]?{...e,...(e.id==='hostile-flanker'?{pose:{...p,y:ground.height+.008,yaw}}:{}),patrol:patrols[e.id]}:e);\n spec.design={...spec.design,teamEncounter:'visible opening exchange between two real moving off-lane combat vehicles',supportRole:'temporary distraction; collision-swept reload patrols, parked during charge; not an escort objective',newVehiclePositions:'short swept patrols off both convoy corridors; persistent wrecks remain solid',openingEvidence:'offline production simulation, compound sweeps and exact main-camera projections; not a GPU/CSS/device pass'};\n return {spec,field};\n}\n", 'src/crushing.js': "import {playerRig} from './player-config.js';\nimport {emitEvent,destroyedColliderIds} from './combat.js';\n/** Hull contact and deliberate traction are required. Gun hits, steering in place,\n * distant objects, and heavy unmarked buildings cannot trigger crushing. */\nexport function stepCrushing(state,dt,world) {\n if(!state.mission.geometry?.some(c=>c.crush))return;\n const speed=state.tankFrame.desiredSpeed;\n if(!Number.isFinite(speed)||Math.abs(speed)<.1)return;\n const contacts=new Set(world.hullContacts?.(state.tank,playerRig(state.mission))||[]);\n for(const c of state.mission.geometry||[]) {\n  const e=state.entities[c.id],seconds=c.crush?.seconds;\n  if(!contacts.has(c.id)||!e?.alive||!c.destructible||!Number.isFinite(seconds)||seconds<=0)continue;\n  const pose=state.tank.pose;\n  const approach=(-(c.x-pose.x)*Math.sin(pose.yaw)-(c.z-pose.z)*Math.cos(pose.yaw))*Math.sign(speed);\n  if(approach<=0)continue;\n  const damage=e.maxHp*dt/seconds*Math.min(1,Math.abs(speed)/1.2);\n  e.hp=Math.max(0,e.hp-damage);e.crushProgress=1-e.hp/e.maxHp;\n  if(e.hp>1e-7)continue;\n  e.hp=0;e.alive=false;e.destroyed=true;e.status='crushed';e.crushProgress=1;\n  e.crushYaw=pose.yaw+(speed<0?Math.PI:0);e.crushedAt=state.elapsed;\n  emitEvent(state,'crushed',{entityId:e.id,position:{...e.pose},value:c.crush.mode||'collapse'});\n  emitEvent(state,'destroyed',{entityId:e.id,position:{...e.pose}});\n  emitEvent(state,'barrier-opened',{entityId:e.id,position:{...e.pose}});\n }\n world.setDestroyed?.(destroyedColliderIds(state));\n}\n", 'src/interceptor.js': "