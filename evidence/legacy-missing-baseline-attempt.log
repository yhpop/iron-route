ec.entities.map(e=>({...e,team:e.kind==='truck'?'allied':'hostile'}));\n const vehicle=(id,team,x,z,yaw,chargeTime,reload,range)=>{\n  const ground=sampleGroundContact(field,x,z,yaw);\n  return {id,kind:'turret',vehicle:'pz3',team,pose:{x,y:ground.height+.008,z,yaw},hp:110,protected:false,damage:12,chargeTime,reload,range,shieldArc:0,radius:2.2,width:1.921792,depth:3.532506,height:1.7,speed:0,travel:0};\n };\n spec.entities.push(vehicle('allied-support','allied',-27,2,0,2.4,5,26),vehicle('hostile-flanker','hostile',-27,-19,Math.PI,2,4.2,22));\n spec.design={...spec.design,teamEncounter:'allied support exchanges fire with hostile western flanker; neither is a victory target',supportRole:'temporary distraction, not invulnerable escort replacement',friendlyFireRule:'allied bodies absorb shells without friendly damage',newVehiclePositions:'stationary west of convoy centreline; persistent wrecks remain off lane'};\n return {spec,field};\n}\n", 'src/crossfire-v3-front.js': "import {createCrossfireFront} from './crossfire-front.js';\nimport {sampleGroundContact} from './terrain-candidate/heightfield.js';\n/** Independent V3 encounter. Static support/flanker use the unchanged real combat\n * system; this builder adds neither mobile AI nor scripted/fake fire. V2 stays frozen. */\nexport function createCrossfireV3Front(){\n const {spec,field}=createCrossfireFront();\n spec.id='mission-9051';spec.index=9051;spec.crossfireV3=true;\n spec.title='焦土交叉火线 V3 · 前沿接应';\n spec.briefing='护送补给车到达北侧接应区。开局左前方的蓝方支援车与敌方侧翼车会真实交火；两车在路外固定阵位，支援车不是护送目标，损失它不会直接失败。东侧硬路短但有敌车封锁，西侧绕行可借山脊掩护。按 H 或点车队待命，先侦察再推进。友军会挡住炮弹：不要朝补给车或支援车开火，也不要挡在友军炮口前。无需消灭所有敌人，别让敌车残骸堵住车队路线。';\n const positions={'allied-support':{x:-4,z:18},'hostile-flanker':{x:-10,z:9}};\n spec.entities=spec.entities.map(e=>{const p=positions[e.id];if(!p)return e;const other=positions[e.id==='allied-support'?'hostile-flanker':'allied-support'],yaw=Math.atan2(-(other.x-p.x),-(other.z-p.z)),ground=sampleGroundContact(field,p.x,p.z,yaw);return {...e,pose:{...p,y:ground.height+.008,yaw}};});\n spec.design={...spec.design,teamEncounter:'visible opening exchange between two stationary off-lane real combat vehicles',supportRole:'static temporary distraction; no mobile AI or escort objective',newVehiclePositions:'opening southwest shoulder clear of both convoy route corridors; persistent wrecks stay off lane',openingEvidence:'offline production simulation and exact main-camera projections; not a device render pass'};\n return {spec,field};\n}\n", 'src/crossfire-v4-front.js': "import {createCrossfireV3Front} from './crossfire-v3-front.js';\nimport {sampleGroundContact} from './terrain-candidate/heightfield.js';\n/** Independent opt-in V4: the existing combatants use production collision-swept\n * PzIII patrols. Weapons, terrain, convoy routes and the five chassis are unchanged.\n * Short routes were selected by actual 30-second compound-sweep/combat evidence. */\nexport function createCrossfireV4Front(){\n const {spec,field}=createCrossfireV3Front();\n spec.id='mission-9052';spec.index=9052;spec.crossfireV4=true;\n spec.title='焦土交叉火线 V4 · 机动接应';\n spec.briefing='护送补给车到达北侧接应区。开局前方的蓝方支援车与敌方侧翼车会真实交火；两车会在装填间歇沿短路线机动，瞄准蓄力时停车，遇到障碍也会停下。支援车不是护送目标，损失它不会直接失败。东侧硬路短但有敌车封锁，西侧绕行可借山脊掩护。按 H 或点车队待命，先侦察再推进。友军会挡住炮弹：不要朝补给车或支援车开火，也不要挡在友军炮口前。无需消灭所有敌人，别让敌车残骸堵住车队路线。';\n const patrols={'allied-support':[{x:-4,z:18},{x:-5,z:16}],'hostile-flanker':[{x:1.2,z:16},{x:0,z:16}]};\n // V4-only relocation avoids the inherited steep ridge: the authored PzIII\n // view is upright, so terrain fit was checked against its real mesh + treads.\n const support=spec.entities.find(e=>e.id==='allied-support').pose,p={x:1.2,z:16},yaw=Math.atan2(-(support.x-p.x),-(support.z-p.z)),ground=sampleGroundContact(field,p.x,p.z,yaw);\n spec.entities=spec.entities.map(e=>patrols[e.id]?{...e,...(e.id==='hostile-flanker'?{pose:{...p,y:ground.height+.008,yaw}}:{}),patrol:patrols[e.id]}:e);\n spec.design={...spec.design,teamEncounter:'visible opening exchange between two real moving off-lane combat vehicles',supportRole:'temporary distraction; collision-swept reload patrols, parked during charge; not an escort objective',newVehiclePositions:'short swept patrols off both convoy corridors; persistent wrecks remain solid',openingEvidence:'offline production simulation, compound sweeps and exact main-camera projections; not a GPU/CSS/device pass'};\n return {spec,field};\n}\n", 'src/crushing.js': "import {playerRig} from './player-config.js';\nimport {emitEvent,destroyedColliderIds} from './combat.js';\n/** Hull contact and deliberate traction are required. Gun hits, steering in place,\n * distant objects, and heavy unmarked buildings cannot trigger crushing. */\nexport function stepCrushing(state,dt,world) {\n if(!state.mission.geometry?.some(c=>c.crush))return;\n const speed=state.tankFrame.desiredSpeed;\n if(!Number.isFinite(speed)||Math.abs(speed)<.1)return;\n const contacts=new Set(world.hullContacts?.(state.tank,playerRig(state.mission))||[]);\n for(const c of state.mission.geometry||[]) {\n  const e=state.entities[c.id],seconds=c.crush?.seconds;\n  if(!contacts.has(c.id)||!e?.alive||!c.destructible||!Number.isFinite(seconds)||seconds<=0)continue;\n  const pose=state.tank.pose;\n  const approach=(-(c.x-pose.x)*Math.sin(pose.yaw)-(c.z-pose.z)*Math.cos(pose.yaw))*Math.sign(speed);\n  if(approach<=0)continue;\n  const damage=e.maxHp*dt/seconds*Math.min(1,Math.abs(speed)/1.2);\n  e.hp=Math.max(0,e.hp-damage);e.crushProgress=1-e.hp/e.maxHp;\n  if(e.hp>1e-7)continue;\n  e.hp=0;e.alive=false;e.destroyed=true;e.status='crushed';e.crushProgress=1;\n  e.crushYaw=pose.yaw+(speed<0?Math.PI:0);e.crushedAt=state.elapsed;\n  emitEvent(state,'crushed',{entityId:e.id,position:{...e.pose},value:c.crush.mode||'collapse'});\n  emitEvent(state,'destroyed',{entityId:e.id,position:{...e.pose}});\n  emitEvent(state,'barrier-opened',{entityId:e.id,position:{...e.pose}});\n }\n world.setDestroyed?.(destroyedColliderIds(state));\n}\n", 'src/interceptor.js': "import {playerCollider} from './player-config.js';\n/** Game-scale adapter of konserwa CC0 Panzer III; values are not historical statistics. */\nexport const INTERCEPTOR_RIG=Object.freeze({yawHeight:1.044,pitchHeight:.182,pitchForward:.56,barrelLength:1.52,minElevation:-.12,maxElevation:.3,maxRecoil:.07});\nconst wrap=n=>Math.atan2(Math.sin(n),Math.cos(n));\n/** Shared measured compound sweep; conservative fallback only for limited adapters.\n * A vehicle parks while aiming, then relocates during its reload window. */\nexport function stepInterceptors(state,dt,world){\n for(const e of Object.values(state.entities)){\n  if(e.vehicle!=='pz3'||!e.alive)continue;\n  e.speed=Number.isFinite(e.speed)?e.speed:0;\n  if(e.charge>0||e.telegraphTarget){e.speed=0;continue;}\n  const points=e.patrol;if(!Array.isArray(points)||points.length<2){e.speed=0;continue;}\n  let index=e.patrolIndex??1;const goal=points[index%points.length];\n  const dx=goal.x-e.pose.x,dz=goal.z-e.pose.z,remaining=Math.hypot(dx,dz);\n  if(remaining<.08){e.patrolIndex=(index+1)%points.length;e.speed=0;continue;}\n  const desired=Math.atan2(-dx,-dz),turn=wrap(desired-e.pose.yaw),angle=Math.max(-dt*.6,Math.min(dt*.6,turn));\n  const speed=Math.min(1.35,e.speed+.65*dt)*Math.max(0,Math.cos(turn));\n  const yaw=wrap(e.pose.yaw+angle),travel=Math.min(remaining,speed*dt);\n  let next={...e.pose,yaw,x:e.pose.x-Math.sin(yaw)*travel,z:e.pose.z-Math.cos(yaw)*travel};\n  let blocked=false;\n  if(world.sweepHullAndAttachedGun){\n   const from=interceptorCollider(e),to=interceptorCollider({...e,pose:next});\n   const sweep=world.sweepHullAndAttachedGun(from,to,INTERCEPTOR_COLLISION_RIG,[e.id]);\n   next=sweep.accepted.pose;blocked=!!sweep.blocked;\n   if(blocked&&Math.hypot(next.x-e.pose.x,next.z-e.pose.z)<1e-9&&Math.abs(wrap(next.yaw-e.pose.yaw))<1e-9){e.speed=0;e.patrolBlocked=true;continue;}\n  }else{\n   if(!world.isRouteClear?.({points:[e.pose,next],width:4.4},{width:4.4,depth:4.4,height:1.7,ignoreIds:[e.id]})){e.speed=0;e.patrolBlocked=true;continue;}\n   if(world.groundPose)next=world.groundPose(next);\n  }\n  const acceptedTravel=Math.hypot(next.x-e.pose.x,next.z-e.pose.z),acceptedTurn=wrap(next.yaw-e.pose.yaw);\n  e.pose=next;e.speed=blocked?0:speed;e.travel=(e.travel||0)+acceptedTravel;e.turnTravel=(e.turnTravel||0)+acceptedTurn;e.patrolBlocked=blocked;\n  world.setEntities?.([...Object.values(state.entities).filter(x=>x.alive||x.vehicle==='pz3').map(x=>x.vehicle==='pz3'?interceptorCollider(x):x),(state.mission.playerVehicle?playerCollider(state):{id:'tank',kind:'tank',pose:state.tank.pose,turret:state.tank.turret,width:1.9,depth:2.9,height:1.5})]);\n }\n}\n\n/** Bounds measured from the shipped GLB, not a shrink-to-feel radius.\n * Turret includes the mantlet envelope; the bore uses a measured capsule. */\nexport const INTERCEPTOR_COLLISION_RIG=Object.freeze({\n hullProxy:{width:1.921792,height:1.074415,depth:3.532506,offset:{x:-.013286,y:.5372075,z:.140351}},\n turretProxy:{width:1.196418,height:.60125,depth:1.3903,offset:{x:.0061085,y:.30073,z:-.048919}},\n turretPivot:{x:0,y:1.044,z:0},barrelPivot:{x:0,y:.182,z:-.56},\n barrelCapsule:{radius:.065},muzzleLocal:{x:0,y:0,z:-1.52},\n});\nexport function interceptorCollider(e){\n return {...e,kind:'tank',rig:INTERCEPTOR_COLLISION_RIG,turret:{yawRel:(e.aimYaw??e.pose.yaw)-e.pose.yaw,elevation:e.aimElevation||0,recoil:0},\n  alive:true,destroyed:false,hp:undefined,width:1.921792,depth:3.532506,height:1.645451};\n}\n", 'src/mission-runtime.js': "import {playerRig} from './player-config.js';\nimport { DEFAULT_CONFIG } from './tank-controller.js';\nimport { emitEvent, syncWorldEntities } from './combat.js';\n\nconst finite = (value, fallback) => Number.isFinite(value) ? value : fallback;\nconst distance = (a, b) => Math.hypot(a.x - b.x, a.z - b.z);\nconst wrap = value => Math.atan2(Math.sin(value), Math.cos(value));\nconst clamp = (v, a, b) => Math.max(a, Math.min(b, v));\n\nexport function pointInZone(point, zone) {\n  if (!zon