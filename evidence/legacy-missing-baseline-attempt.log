ontinue;\n  for(const p of RUINED_DEPOT_FOUNDATIONS){const distance=Math.max(p.minX-x,x-p.maxX,p.minZ-z,z-p.maxZ,0);if(distance>=p.blend)continue;const weight=1-smooth(distance/p.blend);field.heights[k]+=weight*(p.height-field.heights[k]);}\n }\n spec.id='mission-9070';spec.index=9070;spec.slug='ruined-depot';spec.ruinedDepot=true;\n spec.title='废弃货场 · 断墙护送';\n spec.briefing='护送补给车到达北侧接应区。山脊工房、装卸区断墙与东侧窗墙都是真实掩体；炮弹可穿过窗口和低矮缺口，但人行破口不是坦克通道。东路较短却有敌车封锁，西路可借山脊掩护。按 H 或点车队待命，先侦察再推进。友军与残骸会挡住炮弹和车辆，别挡住友军炮口或把敌车残骸留在车队路线上。无需消灭所有敌人。';\n spec.ruinedDepotLayout=RUINED_DEPOT_LAYOUT;spec.ruinedDepotFoundations=RUINED_DEPOT_FOUNDATIONS;\n spec.geometry=[...spec.geometry.filter(c=>c.id!=='scorched-east-low-wall'),...ruinedDepotColliders()];\n spec.design={...spec.design,terrainChange:'One bounded cut/fill workshop pad; protected roads/spawn/opening unchanged; same field for rendering and physics',ruinCollision:'757 exact exported triangles for new projectile/LOS rays; 61 conservative movement spans, omitted rebar/crown mass',ruinComposition:'Three coherent structures. West loading bay relocated to level apron: not universally visible from the opening camera.'};\n return {spec,field};\n}\n", 'src/ruined-depot-layout.js': "import {RUINED_DEPOT_COLLISION} from './ruined-depot-collision-data.js';\n// Module transforms are shared verbatim by view, movement and exact shell rays.\n// The left L is deliberately a west-route loading bay, not forced onto the ridge.\nexport const RUINED_DEPOT_LAYOUT=Object.freeze([\n Object.freeze({id:'ruin-west-loading',moduleId:'broken-corner',x:-30,y:0,z:18,yaw:Math.PI}),\n Object.freeze({id:'ruin-ridge-workshop',moduleId:'workshop',x:0,y:3.2,z:2,yaw:Math.PI}),\n Object.freeze({id:'ruin-east-window',moduleId:'window-wall',x:19.5,y:0,z:0,yaw:Math.PI/2})\n]);\nexport const RUINED_DEPOT_FOUNDATIONS=Object.freeze([\n Object.freeze({id:'ridge-workshop-pad',minX:-5,maxX:5,minZ:-4.5,maxZ:8.5,height:3.2,blend:4})\n]);\nexport function ruinedDepotPoint(p,instance){const c=Math.cos(instance.yaw),s=Math.sin(instance.yaw);return {x:instance.x+c*p[0]+s*p[2],y:instance.y+p[1],z:instance.z-s*p[0]+c*p[2]};}\n/** Conservative inscribed merged wall spans for movement, never projectile rays.\n * Thin rebar, jagged crowns and tiny fracture mass are intentionally omitted. */\nexport function ruinedDepotColliders(instances=RUINED_DEPOT_LAYOUT){return instances.flatMap(i=>{\n const module=RUINED_DEPOT_COLLISION.modules[i.moduleId];if(!module)throw new Error(`Unknown ruin module ${i.moduleId}`);\n return module.boxes.map(b=>({...b,...ruinedDepotPoint([b.x,b.y,b.z],i),id:`${i.id}:${b.id}`,ruinInstanceId:i.id,kind:'box',yaw:i.yaw+(b.yaw||0)}));\n});}\n", 'src/ruined-depot-world.js': "import {createTerrainCombatWorld} from './terrain-candidate/combat-world.js';\nimport {RUINED_DEPOT_COLLISION} from './ruined-depot-collision-data.js';\nimport {RUINED_DEPOT_LAYOUT,ruinedDepotPoint} from './ruined-depot-layout.js';\nconst sub=(a,b)=>({x:a.x-b.x,y:a.y-b.y,z:a.z-b.z}),dot=(a,b)=>a.x*b.x+a.y*b.y+a.z*b.z,cross=(a,b)=>({x:a.y*b.z-a.z*b.y,y:a.z*b.x-a.x*b.z,z:a.x*b.y-a.y*b.x});\nfunction intersectsBounds(a,d,b){let lo=0,hi=1;for(const k of ['x','y','z']){if(Math.abs(d[k])<1e-12){if(a[k]<b.min[k]-1e-9||a[k]>b.max[k]+1e-9)return false;}else{let n=(b.min[k]-a[k])/d[k],f=(b.max[k]-a[k])/d[k];if(n>f)[n,f]=[f,n];lo=Math.max(lo,n);hi=Math.min(hi,f);if(lo>hi+1e-9)return false;}}return true;}\nfunction triangleHit(a,d,tri){const [p,q,r]=tri,e=sub(q,p),v=sub(r,p),h=cross(d,v),det=dot(e,h);if(Math.abs(det)<1e-12)return null;const s=sub(a,p),u=dot(s,h)/det;if(u< -1e-9||u>1+1e-9)return null;const k=cross(s,e),w=dot(d,k)/det;if(w< -1e-9||u+w>1+1e-9)return null;const t=dot(v,k)/det;if(t< -1e-9||t>1+1e-9)return null;const normal=cross(e,v),length=Math.hypot(normal.x,normal.y,normal.z);if(length<1e-12)return null;const sign=dot(normal,d)>0?-1:1;return {fraction:Math.max(0,Math.min(1,t)),normal:{x:sign*normal.x/length,y:sign*normal.y/length,z:sign*normal.z/length}};}\n/** New-mission composition only. Movement remains original production queries.\n * Approximate NEW proxy IDs are ignored only by the base projectile query. */\nexport function createRuinedDepotWorld(spec,field){\n const base=createTerrainCombatWorld(spec,field),proxyIds=(spec.geometry||[]).filter(c=>c.ruinInstanceId).map(c=>c.id),instances=(spec.ruinedDepotLayout||RUINED_DEPOT_LAYOUT).map(i=>{\n  const module=RUINED_DEPOT_COLLISION.modules[i.moduleId];if(!module)throw new Error(`Unknown ruin module ${i.moduleId}`);\n  const triangles=module.triangles.map(t=>t.map(p=>ruinedDepotPoint(p,i))),points=triangles.flat(),bounds={min:{},max:{}};for(const k of ['x','y','z']){bounds.min[k]=Math.min(...points.map(p=>p[k]));bounds.max[k]=Math.max(...points.map(p=>p[k]));}return {id:i.id,triangles,bounds};\n });let disposed=false,destroyed=new Set();\n return {...base,diagnostics:{exactTriangles:instances.reduce((s,i)=>s+i.triangles.length,0),instances:instances.length,movementSpanCount:proxyIds.length,instanceAABBBroadphase:true},\n  raycast(from,to,ignoreIds=[]){\n   if(disposed)throw new Error('Ruined depot world is disposed');if(![from.x,from.y,from.z,to.x,to.y,to.z].every(Number.isFinite))throw new TypeError('Finite segment required');\n   const ignored=new Set(ignoreIds),d=sub(to,from),length=Math.hypot(d.x,d.y,d.z);let best=base.raycast(from,to,[...ignoreIds,...proxyIds]);\n   for(const instance of instances){if(ignored.has(instance.id)||destroyed.has(instance.id)||!intersectsBounds(from,d,instance.bounds))continue;for(let triangleIndex=0;triangleIndex<instance.triangles.length;triangleIndex++){\n    const hit=triangleHit(from,d,instance.triangles[triangleIndex]);if(!hit||best&&hit.fraction>=best.fraction-1e-12)continue;\n    const position={x:from.x+d.x*hit.fraction,y:from.y+d.y*hit.fraction,z:from.z+d.z*hit.fraction};best={...hit,id:instance.id,colliderId:instance.id,triangleIndex,fraction:hit.fraction,distance:length*hit.fraction,point:position,position};\n   }}return best;\n  },setDestroyed(ids=[]){if(disposed)throw new Error('Ruined depot world is disposed');destroyed=new Set(ids);const ownerSpans=(spec.geometry||[]).filter(c=>destroyed.has(c.ruinInstanceId)).map(c=>c.id);base.setDestroyed([...ids,...ownerSpans]);},\n  dispose(){if(disposed)return;disposed=true;base.dispose();destroyed.clear();instances.length=0;}\n };\n}\n", 'src/scanned-cover-front.js': "import {createCrossfireV4Front} from './crossfire-v4-front.js';\nimport {sampleHeightfield} from './terrain-candidate/heightfield.js';\nexport const SCANNED_COVER_IDS=Object.freeze(['scan-east-entry','scan-east-mid','scan-west-shoulder']);\n/** Exact scan envelope: box collision intentionally fills chips and lifting loops. */\nexport function createScannedCoverFront(){\n const {spec,field}=createCrossfireV4Front();\n spec.id='mission-9060';spec.index=9060;spec.slug='scanned-cover';spec.scannedCover=true;spec.title='实景混凝土掩体 · 资源候选';\n spec.geometry=[...spec.geometry,...[[19.5,16],[19.5,-12],[-26.2,8]].map(([x,z],i)=>({id:SCANNED_COVER_IDS[i],kind:'box',x,z,y:sampleHeightfield(field,x,z).height,yaw:Math.PI/2,width:1.56540936,depth:.44214198,height:1.11195294}))];\n return {spec,field};\n}\n", 'src/scorched-front.js': "import {createVerticalSlice} from './terrain-candidate/vertical-slice.js';\nimport {sampleHeightfield} from './terrain-candidate/heightfield.js';\n/** Isolated optional sortie. No edits to the campaign registry or old builders. */\nexport function createScorchedFront(){\n const {spec,field}=createVerticalSlice();\n spec.id='mission-9040';spec.index=9040;spec.optional=true;spec.scorchedFront=true;spec.livingWorld=false;\n spec.title='焦土货运站 · 穿越封锁';\n spec.briefing='护送补给车穿过废弃货运站，到达北侧接应区。东侧硬路短，但装甲巡逻车封锁路口；西侧泥路较长，中央山脊可遮挡炮火。东路外沿的混凝土断墙是真实掩体，不能碾碎；西侧木栅仍可履带压开。按 H 或点车队待命，先侦察再让车队前进。远处烟柱只是环境，不会挡住敌人的视线。无需消灭所有敌人，别把敌车残骸堵在车队路线上。';\n const walls=[\n  {id:'scorched-east-cover',x:19.5,z:9,width:.7,depth:4,height:1.8},\n  {id:'scorched-east-low-wall',x:19.5,z:-4,width:.8,depth:3,height:1.05},\