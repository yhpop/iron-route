-mission composition only. Movement remains original production queries.\n * Approximate NEW proxy IDs are ignored only by the base projectile query. */\nexport function createRuinedDepotWorld(spec,field){\n const base=createTerrainCombatWorld(spec,field),proxyIds=(spec.geometry||[]).filter(c=>c.ruinInstanceId).map(c=>c.id),instances=(spec.ruinedDepotLayout||RUINED_DEPOT_LAYOUT).map(i=>{\n  const module=RUINED_DEPOT_COLLISION.modules[i.moduleId];if(!module)throw new Error(`Unknown ruin module ${i.moduleId}`);\n  const triangles=module.triangles.map(t=>t.map(p=>ruinedDepotPoint(p,i))),points=triangles.flat(),bounds={min:{},max:{}};for(const k of ['x','y','z']){bounds.min[k]=Math.min(...points.map(p=>p[k]));bounds.max[k]=Math.max(...points.map(p=>p[k]));}return {id:i.id,triangles,bounds};\n });let disposed=false,destroyed=new Set();\n return {...base,diagnostics:{exactTriangles:instances.reduce((s,i)=>s+i.triangles.length,0),instances:instances.length,movementSpanCount:proxyIds.length,instanceAABBBroadphase:true},\n  raycast(from,to,ignoreIds=[]){\n   if(disposed)throw new Error('Ruined depot world is disposed');if(![from.x,from.y,from.z,to.x,to.y,to.z].every(Number.isFinite))throw new TypeError('Finite segment required');\n   const ignored=new Set(ignoreIds),d=sub(to,from),length=Math.hypot(d.x,d.y,d.z);let best=base.raycast(from,to,[...ignoreIds,...proxyIds]);\n   for(const instance of instances){if(ignored.has(instance.id)||destroyed.has(instance.id)||!intersectsBounds(from,d,instance.bounds))continue;for(let triangleIndex=0;triangleIndex<instance.triangles.length;triangleIndex++){\n    const hit=triangleHit(from,d,instance.triangles[triangleIndex]);if(!hit||best&&hit.fraction>=best.fraction-1e-12)continue;\n    const position={x:from.x+d.x*hit.fraction,y:from.y+d.y*hit.fraction,z:from.z+d.z*hit.fraction};best={...hit,id:instance.id,colliderId:instance.id,triangleIndex,fraction:hit.fraction,distance:length*hit.fraction,point:position,position};\n   }}return best;\n  },setDestroyed(ids=[]){if(disposed)throw new Error('Ruined depot world is disposed');destroyed=new Set(ids);const ownerSpans=(spec.geometry||[]).filter(c=>destroyed.has(c.ruinInstanceId)).map(c=>c.id);base.setDestroyed([...ids,...ownerSpans]);},\n  dispose(){if(disposed)return;disposed=true;base.dispose();destroyed.clear();instances.length=0;}\n };\n}\n", 'src/scanned-cover-front.js': "import {createCrossfireV4Front} from './crossfire-v4-front.js';\nimport {sampleHeightfield} from './terrain-candidate/heightfield.js';\nexport const SCANNED_COVER_IDS=Object.freeze(['scan-east-entry','scan-east-mid','scan-west-shoulder']);\n/** Exact scan envelope: box collision intentionally fills chips and lifting loops. */\nexport function createScannedCoverFront(){\n const {spec,field}=createCrossfireV4Front();\n spec.id='mission-9060';spec.index=9060;spec.slug='scanned-cover';spec.scannedCover=true;spec.title='实景混凝土掩体 · 资源候选';\n spec.geometry=[...spec.geometry,...[[19.5,16],[19.5,-12],[-26.2,8]].map(([x,z],i)=>({id:SCANNED_COVER_IDS[i],kind:'box',x,z,y:sampleHeightfield(field,x,z).height,yaw:Math.PI/2,width:1.56540936,depth:.44214198,height:1.11195294}))];\n return {spec,field};\n}\n", 'src/scorched-front.js': "import {createVerticalSlice} from './terrain-candidate/vertical-slice.js';\nimport {sampleHeightfield} from './terrain-candidate/heightfield.js';\n/** Isolated optional sortie. No edits to the campaign registry or old builders. */\nexport function createScorchedFront(){\n const {spec,field}=createVerticalSlice();\n spec.id='mission-9040';spec.index=9040;spec.optional=true;spec.scorchedFront=true;spec.livingWorld=false;\n spec.title='焦土货运站 · 穿越封锁';\n spec.briefing='护送补给车穿过废弃货运站，到达北侧接应区。东侧硬路短，但装甲巡逻车封锁路口；西侧泥路较长，中央山脊可遮挡炮火。东路外沿的混凝土断墙是真实掩体，不能碾碎；西侧木栅仍可履带压开。按 H 或点车队待命，先侦察再让车队前进。远处烟柱只是环境，不会挡住敌人的视线。无需消灭所有敌人，别把敌车残骸堵在车队路线上。';\n const walls=[\n  {id:'scorched-east-cover',x:19.5,z:9,width:.7,depth:4,height:1.8},\n  {id:'scorched-east-low-wall',x:19.5,z:-4,width:.8,depth:3,height:1.05},\n  {id:'scorched-west-remnant',x:-30,z:7,width:5,depth:.8,height:1.65}\n ].map(c=>({...c,kind:'box',y:sampleHeightfield(field,c.x,c.z).height}));\n spec.geometry.push(...walls);\n spec.sceneDressing={...spec.sceneDressing,appearance:'scorched',scorchedSources:[{id:'depot-soot',x:-27,z:29,baseHeight:4},{id:'garage-soot',x:28,z:-31,baseHeight:3.2}]};\n spec.design={...spec.design,ecologyRole:'none: barren industrial ground',environmentRole:'solid cover and cosmetic distant smoke; no smoke occlusion or fire damage',terrainChange:'none; original shared field retained',newCoverIds:walls.map(c=>c.id)};\n return {spec,field};\n}\n", 'src/sentry-rig.js': "import {INTERCEPTOR_RIG} from './interceptor.js';\n/** Measured from sentry-turret.glb. Plain-data shared combat/render contract.\n * +Y up, -Z forward; yaw +Y, elevation +X, recoil +Z. No collider change. */\nexport const SENTRY_RIG=Object.freeze({yawHeight:1.1299999952316284,pitchHeight:.1499999761581421,pitchForward:.20740000903606415,barrelLength:.5489999651908875,minElevation:-.08,maxElevation:.35,maxRecoil:.07});\nconst clamp=(n,a,b)=>Math.max(a,Math.min(b,n));\nexport function sentryAim(entity,target){\n const rig=entity.vehicle==='pz3'?INTERCEPTOR_RIG:SENTRY_RIG;\n const p=entity.pose,dx=target.x-p.x,dz=target.z-p.z;\n return {yaw:Math.atan2(-dx,-dz),elevation:clamp(Math.atan2(target.y-p.y-rig.yawHeight-rig.pitchHeight,Math.max(.001,Math.hypot(dx,dz)-rig.pitchForward)),rig.minElevation,rig.maxElevation)};\n}\nexport function sentryMuzzleTransform(entity,recoil=0){\n const r=entity.vehicle==='pz3'?INTERCEPTOR_RIG:SENTRY_RIG,p=entity.pose,yaw=entity.aimYaw??p.yaw??0,elevation=entity.aimElevation??0;\n const length=r.barrelLength-clamp(recoil,0,r.maxRecoil),forward=r.pitchForward+length*Math.cos(elevation);\n return {position:{x:p.x-Math.sin(yaw)*forward,y:(p.y||0)+r.yawHeight+r.pitchHeight+length*Math.sin(elevation),z:p.z-Math.cos(yaw)*forward},direction:{x:-Math.sin(yaw)*Math.cos(elevation),y:Math.sin(elevation),z:-Math.cos(yaw)*Math.cos(elevation)}};\n}\n", 'src/tank-controller.js': "/** Deterministic, planar tracked drivetrain. Metres / seconds / radians; yaw 0 is -Z. */\nconst TAU = Math.PI * 2;\nexport const wrapAngle = value => ((value + Math.PI) % TAU + TAU) % TAU - Math.PI;\nconst finite = (value, fallback = 0) => Number.isFinite(value) ? value : fallback;\nconst clamp = (value, low, high) => Math.max(low, Math.min(high, value));\nconst approach = (value, target, amount) => value + clamp(target - value, -amount, amount);\nconst vec = p => ({ x: finite(p?.x), y: finite(p?.y), z: finite(p?.z) });\nconst add = (a,b) => ({x:a.x+b.x,y:a.y+b.y,z:a.z+b.z});\nexport const rotateYaw = (p, yaw) => ({x:Math.cos(yaw)*p.x+Math.sin(yaw)*p.z,y:p.y,z:-Math.sin(yaw)*p.x+Math.cos(yaw)*p.z});\nconst rotateElevation = (p,a) => ({x:p.x,y:Math.cos(a)*p.y-Math.sin(a)*p.z,z:Math.sin(a)*p.y+Math.cos(a)*p.z});\nconst deepFreeze = value => { for (const child of Object.values(value)) if (child && typeof child === 'object') deepFreeze(child); return Object.freeze(value); };\n\n/** Conservative game-scale tuning, not claimed real-vehicle measurements. Proxies match the derivative V5 rig. */\nexport const DEFAULT_CONFIG = deepFreeze({\n  trackGauge:1.5288, governorCaps:{crawl:1.2,cruise:2.2,travel:3},reverseCap:1.1,boostCap:3.5,\n  accel:1.3,coastDecel:1.2,brakeDecel:3.2,maxYawRate:.7,maxYawAccel:1.2,\n  turretYawRate:1.1,elevationRate:.6,elevationLimits:[-8*Math.PI/180,25*Math.PI/180],\n  recoilDistance:.08,recoilReturnSeconds:.2,\n  rig:{\n    hullProxy:{width:1.899625521,height:.784913416,depth:2.819320527,offset:{x:0,y:.392456705,z:-.000306512}},\n    turretProxy:{width:1.547120,height:.637020,depth:1.502752,offset:{x:0,y:.277092,z:-.033338}},\n    turretPivot:{x:0,y:1.6725492477416992*.455,z:-.11995315551757812*.455},\n    barrelPivot:{x:0,y:.4000358581542969*.455,z:-1.2879886627197266*.455},\n    barrelCapsule:{radius:.151},\n    muzzleLocal:{x:0,y:.0091644287109375,z:-2.3247964334487916},\n    trackLoopMeters:5.977439374291054,wheelRadius:.16835,\n  },\n});\n\nexport function createTank(spawn = {}) {\n  const p=spawn.pose || spawn;\n  return {\n    pose:{...vec(p),yaw:wrapAngle(finite(p.yaw))},vL:0,vR:0,governor:'cruise',trackL:0,trackR:0,\n    turret:{yawRel:0,elevation:0,recoil:0,recoilVelocity:0},\n    blocked:{body:false,barrel:false,muzzle:false},tick:0,\n  };\n}\n\nexport function hullVector(v,pose,inverse=false){\n const b=pose.basis;if(!b)return rotateYaw(v,inverse?-pose.yaw:pose.yaw);\n if(inverse){const q=rotateYaw(v,-pose.yaw);return {x:q.x*b.right[0]+q.y*b.right[1]+q.z*b.right[2],y:q.x*b.up[0]+q.y*b.up[1]+q.z*b.up[2],z:q.x*b.forward[0]+q.y*b.forward[1]+q.z*b.forward[2]};}\n return rotateYaw({x:b.right[0]*v.x+b.up[0]*v.y+b.forward[0]*v.z,y:b.right[1]*v.x+b.up[1]*v.y+b.forward[1]*v.z,z:b.right[2]*v.x+b.up[2]*v.y+b.forward[2]*v.z},pose.yaw);\n}\n/** The same hull -> yaw pivot -> elevation hinge -> recoil slide chain used by the visual rig. */\nexport function getTankTransform(tank, rig = DEFAULT_CONFIG.rig) {\n  const pose=tank.pose, turret=tank.turret;\n  if(pose.basis){\n   const localTurret=vec(rig.turretPivot),localHinge=add(localTurret,rotateYaw(vec(rig.barrelPivot),turret.yawRel));\n   const barrelPoint=p=>add(pose,hullVector(add(localHinge,rotateYaw(rotateElevation({...vec(p),z:finite(p?.z)+turret.recoil},turret.elevation),turret.yawRel)),pose));\n   return {position:barrelPoint(rig.muzzleLocal),direction:hullVector(rotateYaw(rotateElevation({x:0,y:0,z:-1},turret.elevation),turret.yawRel),pose),barrelStart:barrelPoint(rig.barrelCapsule.start||{x:0,y:0,z:0}),barrelEnd:barrelPoint(rig.barrelCapsule.end||rig.muzzleLocal),turretOrigin:add(pose,hullVector(localTurret,pose)),hinge:add(pose,hullVector(localHinge,pose)),pose:{...pose},turret:{...turret}};\n  }\n  const yaw=pose.yaw+turret.yawRel;\n  const turretOrigin=add(pose,rotateYaw(vec(rig.turretPivot),pose.yaw));\n  const hinge=add(turretOrigin,rotateYaw(vec(rig.barrelPivot),yaw));\n  const barrelPoint=point=>add(hinge,rotateYaw(rotateElevation({...vec(point),z:finite(point?.z)+turret.recoil},turret.elevation),yaw));\n  const position=barrelPoint(rig.muzzleLocal);\n  return {\n    position,direction:rotateYaw(rotateElevation({x:0,y:0,z:-1},turret.elevation),yaw),\n    barrelStart:barrelPoint(rig.barrelCapsule.start || {x:0,y:0,z:0}),\n    barrelEnd:barrelPoint(rig.barrelCapsule.end || rig.muzzleLocal),\n    turretOrigin,hinge,pose:{...pose},turret:{...turret},\n  };\n}\n\n/** Exact constant-curvature integration: no independent world-axis velocity and therefore no strafing. */\nexport function integrateArc(pose, distance, angle) {\n  if(Math.abs(angle)<1e-9) return {...pose,x:pose.x-Math.sin(pose.yaw)*distance,z:pose.z-Math.cos(pose.yaw)*distance,yaw:wrapAngle(pose.yaw+angle)};\n  const end=pose.yaw+angle,r=distance/angle;\n  return {...pose,x:pose.x+r*(Math.cos(end)-Math.cos(pose.yaw)),z:pose.z-r*(Math.sin(end)-Math.sin(pose.yaw)),yaw:wrapAngle(end)};\n}\n\nfunction frameFor(state, rig, dt, deltaTrackL, deltaTrackR, canFire, contacts, desiredSpeed, boostActive, surface) {\n  return {\n    pose:{...state.pose},turretYawRel:state.turret.yawRel,elevation:state.turret.elevation,recoil:state.turret.recoil,\n    muzzleWorld:getTankTransform(state,rig),deltaTrackL,deltaTrackR,trackL:state.trackL,trackR:state.trackR,\n    speedForward:(state.vL+state.vR)/2,yawRate:dt>0?wrapAngle(state.pose.yaw-(state._previousYaw??state.pose.yaw))/dt:0,\n    canFire,contacts:[...new Set(contacts)],desiredSpeed,governor:state.governor,boostActive,surface,\n  };\n}\n\nexport function stepTank(previous, rawInput = {}, dt = 1/60, env, config = DEFAULT_CONFIG) {\n  if(!Number.isFinite(dt) || dt<=0 || dt>.1) throw new RangeError('Tank dt must be finite, positive, and <= 0.1 seconds; use a fixed-step accumulator');\n  const state={...previous,pose:{...previous.pose},turret:{...previous.turret},blocked:{...previous.blocked}};\n  const input=rawInput || {};\n  const clearance = tra